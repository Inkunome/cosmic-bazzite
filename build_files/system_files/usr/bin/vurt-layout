#!/bin/bash
# Keyboard layout switcher for the Vurt desktop (sway/swayfx).
# Layout order must match xkb_layout in ~/.config/sway/config:
#   0 = qwerty (default)   1 = azerty   2 = bepo
#
#   vurt-layout next|prev     cycle
#   vurt-layout set <name>    bepo | azerty | qwerty
#   vurt-layout status        print current layout name once
#   vurt-layout watch         print current layout now and on every change (for eww)
set -eu
NAMES=(qwerty azerty bepo)

current() {
    local idx
    idx=$(swaymsg -t get_inputs -r | jq -r '[.[] | select(.type=="keyboard")][0].xkb_active_layout_index // 0')
    echo "${NAMES[$idx]:-?}"
}

switch() { swaymsg -q input type:keyboard xkb_switch_layout "$1"; }

case "${1:-status}" in
    next|prev) switch "$1" ;;
    set)
        for i in "${!NAMES[@]}"; do
            [[ ${NAMES[$i]} == "${2:-}" ]] && { switch "$i"; exit 0; }
        done
        echo "unknown layout '${2:-}' (bepo|azerty|qwerty)" >&2; exit 1 ;;
    status) current ;;
    watch)
        current
        swaymsg -t subscribe -m '["input"]' | while read -r _; do current; done ;;
    *) echo "usage: vurt-layout next|prev|set <bepo|azerty|qwerty>|status|watch" >&2; exit 1 ;;
esac
