// ink: the sway / eww palette (plum, cream, light purple, pink) for zellij.
// loam #1c1424   surface #2a1d36   moss #5b4570   spore #f6eaf4   dim #b9a3c4
// glow #c8a2f0   pink #ff8fc4      feather #ff9ccf amber #ffd1e6    amanita #e0566f   mint #8fd6c0
themes {
    ink {
        // plain text: panes' text, the status bar hints
        text_unselected {
            base "#f6eaf4"
            background "#1c1424"
            emphasis_0 "#c8a2f0"
            emphasis_1 "#ff8fc4"
            emphasis_2 "#8fd6c0"
            emphasis_3 "#ffd1e6"
        }
        text_selected {
            base "#1c1424"
            background "#c8a2f0"
            emphasis_0 "#e0566f"
            emphasis_1 "#5b4570"
            emphasis_2 "#2a1d36"
            emphasis_3 "#ff8fc4"
        }
        // tabs and the keys of the status bar
        ribbon_unselected {
            base "#f6eaf4"
            background "#5b4570"
            emphasis_0 "#ffd1e6"
            emphasis_1 "#f6eaf4"
            emphasis_2 "#c8a2f0"
            emphasis_3 "#ff8fc4"
        }
        ribbon_selected {
            base "#1c1424"
            background "#c8a2f0"
            emphasis_0 "#e0566f"
            emphasis_1 "#2a1d36"
            emphasis_2 "#5b4570"
            emphasis_3 "#ff8fc4"
        }
        table_title {
            base "#ff9ccf"
            background "#1c1424"
            emphasis_0 "#c8a2f0"
            emphasis_1 "#ff8fc4"
            emphasis_2 "#8fd6c0"
            emphasis_3 "#ffd1e6"
        }
        table_cell_unselected {
            base "#f6eaf4"
            background "#2a1d36"
            emphasis_0 "#c8a2f0"
            emphasis_1 "#ff8fc4"
            emphasis_2 "#8fd6c0"
            emphasis_3 "#ffd1e6"
        }
        table_cell_selected {
            base "#1c1424"
            background "#c8a2f0"
            emphasis_0 "#e0566f"
            emphasis_1 "#5b4570"
            emphasis_2 "#2a1d36"
            emphasis_3 "#ff8fc4"
        }
        list_unselected {
            base "#f6eaf4"
            background "#2a1d36"
            emphasis_0 "#c8a2f0"
            emphasis_1 "#ff8fc4"
            emphasis_2 "#8fd6c0"
            emphasis_3 "#ffd1e6"
        }
        list_selected {
            base "#1c1424"
            background "#c8a2f0"
            emphasis_0 "#e0566f"
            emphasis_1 "#5b4570"
            emphasis_2 "#2a1d36"
            emphasis_3 "#ff8fc4"
        }
        // pane borders: dim moss when idle, glow on the focused pane, pink while a mode highlights it
        frame_unselected {
            base "#5b4570"
            background "#1c1424"
            emphasis_0 "#b9a3c4"
            emphasis_1 "#c8a2f0"
            emphasis_2 "#ff8fc4"
            emphasis_3 "#ffd1e6"
        }
        frame_selected {
            base "#c8a2f0"
            background "#1c1424"
            emphasis_0 "#ff8fc4"
            emphasis_1 "#8fd6c0"
            emphasis_2 "#ffd1e6"
            emphasis_3 "#ff9ccf"
        }
        frame_highlight {
            base "#ff8fc4"
            background "#1c1424"
            emphasis_0 "#ffd1e6"
            emphasis_1 "#c8a2f0"
            emphasis_2 "#8fd6c0"
            emphasis_3 "#ff9ccf"
        }
        exit_code_success {
            base "#8fd6c0"
            background "#1c1424"
            emphasis_0 "#c8a2f0"
            emphasis_1 "#ff8fc4"
            emphasis_2 "#ffd1e6"
            emphasis_3 "#f6eaf4"
        }
        exit_code_error {
            base "#e0566f"
            background "#1c1424"
            emphasis_0 "#ff8fc4"
            emphasis_1 "#ffd1e6"
            emphasis_2 "#c8a2f0"
            emphasis_3 "#f6eaf4"
        }
        // colours of the cursors when several people share a session
        multiplayer_user_colors {
            player_1 "#c8a2f0"
            player_2 "#ff8fc4"
            player_3 "#8fd6c0"
            player_4 "#ffd1e6"
            player_5 "#ff9ccf"
            player_6 "#e0566f"
            player_7 "#b9a3c4"
            player_8 "#5b4570"
            player_9 "#f6eaf4"
            player_10 "#6a9a55"
        }
    }
}
