#!/bin/bash
# Two small buttons on the title bar of the focused window, ‹ before the title and › after it: push the window to the previous
# or the next workspace (a new one when there is none that way) (the window comes with you). They are two separate windows so
# that the title stays free: dragging it with the left button moves the window.
#   winpill watch     keep the pill on the focused window (started by sway)
#   winpill show      place it once
#   winpill hide        take the buttons away (they also go by themselves when there is no title bar or no window)
#   winpill prev|next   move the focused window to the previous / next workspace of its screen, or to a new one when
#                       there is none that way (what the buttons run); `winpill new` always makes a new one
#   winpill close       close the focused window (middle click on a button)
here=$(readlink -f "$0"); dir=$(dirname "$here")
GAP=12 H=26 CHAR=8 BW=28 SPACE=8   # height of a button, width of a letter, width of a button, space between a button and the title
LAST="${XDG_RUNTIME_DIR:-/tmp}/ink-winpill.last"

LOCK="${XDG_RUNTIME_DIR:-/tmp}/ink-winpill.lock"
hide() { eww close winpill-l winpill-r 9>&- >/dev/null 2>&1; rm -f "$LAST"; }

# eww monitor index of an output (cached until the screens change)
monitor_of() { "$dir/screens" map | awk -v o="$1" '$1 == o {print $2}'; }

# one `show` at a time: the event loop and the once-a-second loop used to run it together, and one could open the buttons
# just after the other had closed them, leaving buttons for a window that was gone
show() { ( flock -w 3 9 || exit 0; show_now ) 9>"$LOCK"; }

show_now() {
    local info out ox oy tx tw ty tl xl xr y want mon
    # The buttons go on the TOP title bar of the focused window: with groups inside groups (a tabbed group in a tabbed
    # group) there are several bars one under the other, and it is the first that counts. Walk down from the screen to the
    # focused window, take the first tabbed / stacked container on the way and the tab of the next node in it.
    info=$(swaymsg -t get_tree -r | jq -r --argjson cw "$CHAR" '
        # the title sway shows in the tab of a group: its layout letter and its windows, T[Alacritty] or H[Firefox T[Thunar]]
        def gt: if (.pid? != null and .pid != null) then (.name // "")
                else ((if .layout == "splith" then "H" elif .layout == "splitv" then "V" elif .layout == "tabbed" then "T" else "S" end)
                      + "[" + ([.nodes[]? | if (.pid? != null and .pid != null) then (.app_id // .window_properties.class // "") else gt end] | join(" ")) + "]") end;
        def chain: if (.pid? != null and .pid != null and .focused == true) then [.]
                   else ((.nodes[]? | chain) as $c | [.] + $c) end;
        [.nodes[] | select(.type == "output" and .name != "__i3") | chain][0] as $c
        | select($c != null)
        | $c[-1] as $leaf
        | ([range(0; ($c | length) - 1) | select($c[.].layout == "tabbed" or $c[.].layout == "stacked")][0]) as $i
        | select($i != null and $leaf.fullscreen_mode == 0)
        | $c[$i] as $a | $c[$i + 1] as $t
        | select(($t.deco_rect.height // 0) > 0)
        | "\($c[0].name) \($c[0].rect.x) \($c[0].rect.y) \($a.rect.x + $t.deco_rect.x) \($t.deco_rect.width) \(if $a.layout == "stacked" then $a.rect.y + $t.deco_rect.y else $a.rect.y end) \(($t | gt | length) * $cw)"')
    [[ -n $info ]] || { hide; return; }   # no title bar: no buttons
    read -r out ox oy tx tw ty tl <<<"$info"
    # a layer surface is laid out inside the area the bar, strip and dock leave free: measure from the corner of that area
    # (the workspace rect starts one gap further in: outer 4 + inner 8 in the sway config)
    read -r ux uy < <(swaymsg -t get_workspaces -r | jq -r --arg o "$out" '[.[] | select(.output == $o and .visible)][0].rect | "\(.x) \(.y)"')
    ox=$((ux - GAP)); oy=$((uy - GAP))
    y=$((ty - oy + (28 - H) / 2))
    # one button each side of the title shown in that tab, centred on the tab (the window's own title, or the group's)
    ((tl > tw - 20)) && tl=$((tw - 20)); ((tl < 24)) && tl=24
    xl=$((tx + tw / 2 - ox - tl / 2 - SPACE - BW)); xr=$((tx + tw / 2 - ox + tl / 2 + SPACE))
    want="$out $xl $xr $y"
    [[ $(cat "$LAST" 2>/dev/null) == "$want" ]] && eww active-windows 2>/dev/null | grep -q '^winpill-r:' && return
    mon=$(monitor_of "$out"); [[ -n $mon ]] || return
    eww close winpill-l winpill-r 9>&- >/dev/null 2>&1
    eww open winpill-l --arg "mon=$mon" --pos "${xl}x${y}" --size "${BW}x${H}" 9>&- >/dev/null 2>&1 &&
        eww open winpill-r --arg "mon=$mon" --pos "${xr}x${y}" --size "${BW}x${H}" 9>&- >/dev/null 2>&1 && echo "$want" > "$LAST"
}

lowest_free() { local n=1 used; used=$(swaymsg -t get_workspaces -r | jq -r '.[].num'); while grep -qx "$n" <<<"$used"; do n=$((n + 1)); done; echo "$n"; }

case "${1:-watch}" in
    watch)
        # a single watcher per session (a second one would only fight the first)
        exec 8>"${XDG_RUNTIME_DIR:-/tmp}/ink-winpill.watch"; flock -n 8 || exit 0
        poll= sub=
        cleanup() { kill $poll 2>/dev/null; pkill -P "${sub:-0}" 2>/dev/null; kill $sub 2>/dev/null; hide; }
        trap cleanup EXIT
        trap 'exit 0' TERM INT HUP
        show
        # sway sends no event when a layout changes (split <-> tabbed), which is when a title bar appears or goes: look again
        # once a second as well (nothing is redrawn unless the position changed). It ends with the watcher.
        ( while kill -0 $$ 2>/dev/null; do sleep 1; show; done ) 8>&- &
        poll=$!
        # the events of sway; if the subscription drops, take it up again rather than leave the buttons where they were
        ( while kill -0 $$ 2>/dev/null; do
              swaymsg -t subscribe -m '["window","workspace","output"]' | while read -r _; do
                  while read -r -t 0.15 _; do :; done   # let a burst of events settle
                  show
              done
              hide; sleep 2
          done ) 8>&- &
        sub=$!
        wait ;;
    show) show ;;
    hide) hide ;;
    prev|next)
        # the neighbouring workspace of this screen; at the first / last one, a new workspace instead (no wrapping around)
        n=$(swaymsg -t get_workspaces -r | jq -r --arg d "$1" '
            ([.[] | select(.focused)][0]) as $f | [.[] | select(.output == $f.output) | .num] | sort as $l
            | ($l | index($f.num)) as $i
            | if $d == "prev" then (if $i > 0 then $l[$i - 1] else empty end) else $l[$i + 1] // empty end')
        [[ -n $n ]] || n=$(lowest_free)
        swaymsg -q "move container to workspace number $n; workspace number $n" ;;
    close) swaymsg -q kill ;;
    new)  n=$(lowest_free); swaymsg -q "move container to workspace number $n; workspace number $n" ;;
    *) sed -n '2,10p' "$0" >&2; exit 1 ;;
esac
exit 0
