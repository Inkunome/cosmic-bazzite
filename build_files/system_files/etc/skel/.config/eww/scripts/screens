#!/bin/bash
# Per-screen layout: landscape screens get the top bar and a bottom strip (no dock), portrait screens get the dock
# at the bottom (no bar).
#   screens apply [--changed]   (re)open the right windows on every active output (--changed: only if the screens differ
#                               from the last layout)
#   screens watch   re-apply whenever outputs change (plug, unplug, rotate)
here=$(readlink -f "$0")
SIG="${XDG_RUNTIME_DIR:-/tmp}/ink-screens.sig"

# What the layout depends on: which screens there are, and the shape of each after rotation.
sig() {
    swaymsg -t get_outputs -r | jq -r '[.[] | select(.active) | "\(.name) \(.model) \(.rect.width)x\(.rect.height)"] | join(";")'
}

# Where does each eww monitor index land? Opens a small probe window on every index and sees which output gained a
# surface. Prints "OUTPUT INDEX" lines.
probe() {
    local n i before o
    count() { swaymsg -t get_outputs -r | jq -r '.[] | select(.active) | "\(.name) \([.layer_shell_surfaces[]? | select(.namespace == "ink-dock")] | length)"'; }
    n=$(swaymsg -t get_outputs -r | jq '[.[] | select(.active)] | length')
    for ((i = 0; i < n; i++)); do
        before=$(count)
        eww open clock-big --id probe --arg "mon=$i" >/dev/null 2>&1
        o=$(diff <(echo "$before") <(count) | sed -n 's/^> \(.*\) [0-9]*$/\1/p' | head -n1)
        eww close probe >/dev/null 2>&1
        [[ -n $o ]] && echo "$o $i"
    done
}

# The same, without opening windows when nothing changed: the answer is kept until the screens differ. (Opening and closing
# windows right before the launcher opens is the kind of churn that has made the eww daemon crash.)
MAP="${XDG_RUNTIME_DIR:-/tmp}/ink-eww-monitors"
screens_key() { swaymsg -t get_outputs -r | jq -r '[.[] | select(.active) | "\(.name) \(.rect.width)x\(.rect.height)"] | join(";")'; }
map() {
    local key; key=$(screens_key)
    if [[ $(head -n1 "$MAP" 2>/dev/null) != "$key" ]]; then
        # one probe at a time (they share a window id); whoever waited finds the answer already there
        (
            flock 8
            [[ $(head -n1 "$MAP" 2>/dev/null) == "$key" ]] || { { echo "$key"; probe; } > "$MAP.tmp" && mv "$MAP.tmp" "$MAP"; }
        ) 8>"${MAP}.lock"
    fi
    tail -n +2 "$MAP"
}

# Is every portrait screen carrying the dock and every landscape one the bar?
placed() {
    swaymsg -t get_outputs -r | jq -e 'all(.[] | select(.active);
        (.rect.height > .rect.width) == any(.layer_shell_surfaces[]?; .namespace == "ink-dock")
        and (.rect.height > .rect.width) != any(.layer_shell_surfaces[]?; .namespace == "ink-bar"))' >/dev/null
}

apply() {
    # two layouts at once (a late one and a new one) would close each other's windows: run one at a time
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ink-screens.lock"; flock 9
    # `apply --changed` does nothing when the screens are the same as at the last layout and the windows are still there:
    # an output that is only woken up or rebuilt (caffeine, the idle timeout) must not make the bar blink
    if [[ ${1:-} == --changed ]] && [[ "$(sig)" == "$(cat "$SIG" 2>/dev/null)" ]] &&
        eww active-windows 2>/dev/null | grep -qE '^(bar|dock)-' && placed; then return; fi
    # (the daemon must not inherit the lock: it would hold it for as long as eww runs)
    eww ping >/dev/null 2>&1 || { eww daemon 9>&-; sleep 1; }
    "$(dirname "$here")/apps" dock-sync   # the dock list is a plain variable: fill it before a dock opens
    # close what we opened before (ids bar-N, strip-N, dock-N, clock-N and wsd-N)
    eww active-windows 2>/dev/null | awk -F': ' '/^(bar|strip|dock|clock|wsd)-/{print $1}' | while read -r id; do eww close "$id"; done
    # eww 0.6 identifies a monitor by index, which is the order GDK lists them in. That is not always sway's order (after
    # a screen sleeps the portrait layout used to land on the wide screen): find out where each index really lands by
    # opening a small probe window on it and looking at which output received it.
    declare -A at   # output name -> eww monitor index
    rm -f "$MAP"   # (the monitors may have been reordered: probe again)
    while read -r o i; do at[$o]=$i; done < <(map)
    swaymsg -t get_outputs -r | jq -r '[.[] | select(.active)] | to_entries[] | "\(.key) \(.value.rect.width) \(.value.rect.height) \(.value.name)"' |
    while read -r idx w h name; do
        mon=${at[$name]:-$idx}   # (the probe failed: fall back on the position)
        if ((h > w)); then eww open dock --id "dock-$idx" --arg "mon=$mon"; eww open clock-big --id "clock-$idx" --arg "mon=$mon"; eww open ws-dock --id "wsd-$idx" --arg "mon=$mon" --arg "out=$name"
        else eww open bar --id "bar-$idx" --arg "mon=$mon" --arg "out=$name"; eww open strip --id "strip-$idx" --arg "mon=$mon"; fi
    done
    sig > "$SIG"
    [[ -n ${INK_SCREENS_LOG:-} ]] && echo "layout $(date +%T)" >> "$INK_SCREENS_LOG"
}

case "${1:-apply}" in
    apply) apply "${2:-}" ;;
    watch)
        # An output that wakes up from sleep is destroyed and created again, and kanshi rotates it a moment later: wait
        # until the events stop for a second and a half, then lay the screens out on their final shape, and once more a
        # few seconds later in case something (a slow monitor, kanshi) was still moving.
        swaymsg -t subscribe -m '["output"]' | while read -r _; do
            while read -r -t 1.5 _; do :; done
            "$here" apply --changed
            ( sleep 4; "$here" apply --changed ) &
        done ;;
    probe) probe ;;
    map) map ;;
    *) echo "usage: screens apply|watch|probe|map" >&2; exit 1 ;;
esac
exit 0
