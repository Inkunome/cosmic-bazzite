#!/bin/bash
# Per-screen layout: landscape screens get the top bar (no dock), portrait screens get the dock
# at the bottom (no bar).
#   screens apply   (re)open the right windows on every active output
#   screens watch   re-apply whenever outputs change (plug, unplug, rotate)
here=$(readlink -f "$0")

apply() {
    eww ping >/dev/null 2>&1 || { eww daemon; sleep 1; }
    # close what we opened before (ids bar-N, dock-N and clock-N)
    eww active-windows 2>/dev/null | awk -F': ' '/^(bar|dock|clock)-/{print $1}' | while read -r id; do eww close "$id"; done
    # eww 0.6 identifies a monitor by index (or by model), not by connector name: use the position among the
    # active outputs, which is the order GDK lists them in
    swaymsg -t get_outputs -r | jq -r '[.[] | select(.active)] | to_entries[] | "\(.key) \(.value.rect.width) \(.value.rect.height)"' |
    while read -r idx w h; do
        if ((h > w)); then eww open dock --id "dock-$idx" --arg "mon=$idx"; eww open clock-big --id "clock-$idx" --arg "mon=$idx"
        else eww open bar --id "bar-$idx" --arg "mon=$idx"; fi
    done
}

case "${1:-apply}" in
    apply) apply ;;
    watch)
        swaymsg -t subscribe -m '["output"]' | while read -r _; do
            sleep 0.5; "$here" apply   # let the burst of events settle
        done ;;
    *) echo "usage: screens apply|watch" >&2; exit 1 ;;
esac
exit 0
