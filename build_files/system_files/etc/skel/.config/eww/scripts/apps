#!/usr/bin/python3
"""Application index, search and pinning for the Ink dashboard.

  apps search <query>   print matches as JSON and push them to eww (vars: query, results)
  apps run <query>      launch the best match for <query>, then close the dashboard
  apps launch <id>      launch an application by desktop-file id, then close the dashboard
  apps pinned           print pinned apps as JSON and push them to eww (var: pinned)
  apps toggle-pin <id>  pin or unpin an application, then refresh `pinned`
  apps dock             print the dock apps as JSON
  apps dock-sync        push them to eww (variable dock_apps); the screens script runs it before opening a dock
  apps dock-toggle <id> add an application to the dock, or remove it from the dock
  apps nav next|prev    move the selection in the open launcher (sway binds Down, Up, Tab, Shift+Tab to this, and
                        Left, Right while the search field is empty)
  apps accept           launch the selected entry (sway binds Return to this)
"""
import configparser, glob, json, os, shlex, subprocess, sys, time
from urllib.parse import quote, unquote

HOME = os.path.expanduser("~")
DIRS = ["/usr/share/applications", "/usr/local/share/applications",
        "/var/lib/flatpak/exports/share/applications",
        f"{HOME}/.local/share/flatpak/exports/share/applications",
        f"{HOME}/.local/share/applications"]
ICON_DIRS = ["/usr/share/icons", "/usr/share/pixmaps", "/var/lib/flatpak/exports/share/icons",
             f"{HOME}/.local/share/flatpak/exports/share/icons", f"{HOME}/.local/share/icons"]
CACHE = f"{HOME}/.cache/ink/apps.json"
PINS = f"{HOME}/.config/ink/pinned"
DEFAULT_PINS = ["org.mozilla.firefox", "firefox", "Alacritty", "thunar", "org.gnome.Settings",
                "pavucontrol", "blueman-manager", "system-config-printer"]
MAX_PINNED, MAX_RESULTS = 8, 7

# The dock (portrait screens). Its list lives in ~/.config/ink/dock, one id per line. The four first entries are
# built in: they have their own Ink icon and launch command (scripts/launch); their desktop-file ids are aliases, so
# adding Firefox from the launcher does not make a second Firefox icon.
DOCK = f"{HOME}/.config/ink/dock"
BUILTIN = {"browser": "Firefox", "terminal": "Terminal", "files": "Files", "settings": "Settings"}
ALIASES = {"browser": {"org.mozilla.firefox", "firefox"}, "terminal": {"alacritty", "org.alacritty.alacritty"},
           "files": {"thunar", "org.xfce.thunar"}, "settings": {"org.gnome.settings", "gnome-control-center"}}
ICON_DIR = f"{HOME}/.config/eww/icons"


def newest_mtime():
    m = 0
    for d in DIRS:
        try:
            m = max(m, os.stat(d).st_mtime)
        except OSError:
            pass
    return m


def icon_index():
    """basename -> best file (prefers scalable svg, then the largest png up to 256px)."""
    best = {}
    for root in ICON_DIRS:
        for dirpath, _, files in os.walk(root):
            for f in files:
                stem, ext = os.path.splitext(f)
                if ext not in (".svg", ".png"):
                    continue
                size = 9999 if ext == ".svg" else 0
                for part in dirpath.split(os.sep):
                    if "x" in part and part.split("x")[0].isdigit():
                        size = int(part.split("x")[0])
                if size > 256 and ext == ".png":
                    continue
                if stem not in best or size > best[stem][0]:
                    best[stem] = (size, os.path.join(dirpath, f))
    return {k: v[1] for k, v in best.items()}


def build():
    icons = icon_index()
    apps = {}
    for d in DIRS:
        for path in glob.glob(f"{d}/*.desktop"):
            cp = configparser.RawConfigParser(strict=False, interpolation=None)
            cp.optionxform = str
            try:
                cp.read(path, encoding="utf-8")
                e = cp["Desktop Entry"]
            except Exception:
                continue
            if e.get("Type") != "Application" or e.get("NoDisplay", "false").lower() == "true" \
               or e.get("Hidden", "false").lower() == "true":
                continue
            ident = os.path.basename(path)[:-8]
            icon = e.get("Icon", "")
            icon_path = icon if os.path.isabs(icon) and os.path.exists(icon) else icons.get(icon, "")
            apps[ident] = {"id": ident, "name": e.get("Name", ident), "icon": icon_path,
                           "initial": (e.get("Name", ident)[:1] or "?").upper(),
                           "keywords": " ".join([e.get("GenericName", ""), e.get("Comment", ""), e.get("Keywords", ""), ident])}
    out = sorted(apps.values(), key=lambda a: a["name"].lower())
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as f:
        json.dump(out, f)
    return out


def load():
    try:
        if os.path.getmtime(CACHE) > newest_mtime():
            with open(CACHE) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    return build()


def pins():
    try:
        with open(PINS) as f:
            return [l.strip() for l in f if l.strip()]
    except OSError:
        return list(DEFAULT_PINS)


def resolve_pinned(apps):
    by_id = {a["id"].lower(): a for a in apps}
    out, seen = [], set()
    for p in pins():
        a = by_id.get(p.lower())
        if a and a["id"] not in seen:
            out.append(a)
            seen.add(a["id"])
    return [dict(p, idx=i) for i, p in enumerate(with_q(out[:MAX_PINNED]))]


def search(apps, q):
    q = q.strip().lower()
    if not q:
        return []
    pinned = {a["id"] for a in resolve_pinned(apps)}
    docked = docked_set()
    scored = []
    for a in apps:
        n, k = a["name"].lower(), a["keywords"].lower()
        s = 100 if n.startswith(q) else 80 if any(w.startswith(q) for w in n.split()) else 60 if q in n else 30 if q in k else 0
        if s:
            scored.append((-s, n, dict(a, pinned=a["id"] in pinned, docked=canon(a["id"]).lower() in docked, q=quote(a["id"], safe=""))))
    scored.sort(key=lambda t: t[:2])
    out = [t[2] for t in scored[:MAX_RESULTS]]
    for i, r in enumerate(out):
        r["idx"] = i          # position in the list: the launcher highlights the one equal to `sel`
    return out


def canon(ident):
    low = ident.lower()
    for key, names in ALIASES.items():
        if low == key or low in names:
            return key
    return ident


def dock_ids():
    try:
        with open(DOCK) as f:
            return [l.strip() for l in f if l.strip()]
    except OSError:
        return list(BUILTIN)


def docked_set():
    return {canon(i).lower() for i in dock_ids()}


def dock_items(apps):
    by_id = {a["id"].lower(): a for a in apps}
    out, seen = [], set()
    for d in dock_ids():
        c = canon(d)
        if c.lower() in seen:
            continue
        if c in BUILTIN:
            out.append({"id": c, "q": c, "name": BUILTIN[c], "icon": f"{ICON_DIR}/{c}.svg", "initial": BUILTIN[c][0], "builtin": True})
        elif c.lower() in by_id:
            a = by_id[c.lower()]
            out.append({"id": a["id"], "q": quote(a["id"], safe=""), "name": a["name"], "icon": a["icon"],
                        "initial": a["initial"], "builtin": False})
        else:
            continue
        seen.add(c.lower())
    return out


def with_q(apps):
    """Add `q`, the id percent-encoded, to each app. eww pastes it into a shell command, so it must hold no space,
    bracket or quote; `launch` and `toggle-pin` decode it."""
    docked = docked_set()
    return [dict(a, q=quote(a["id"], safe=""), docked=canon(a["id"]).lower() in docked) for a in apps]


def eww_get(var):
    r = subprocess.run(["eww", "get", var], capture_output=True, text=True)
    return r.stdout.strip()


def launcher_items():
    """What the open launcher shows: the search results while something is typed, the pinned apps otherwise."""
    if "launcher" not in subprocess.run(["eww", "active-windows"], capture_output=True, text=True).stdout:
        return None
    var = "results" if eww_get("query").strip() else "pinned"
    try:
        return json.loads(eww_get(var))
    except ValueError:
        return []


def say(text):
    """Show a short confirmation in the open launcher (variable lmsg), and clear it after a few seconds, unless a newer
    message replaced it."""
    eww(lmsg=text)
    subprocess.Popen(["sh", "-c", 'sleep 2.5; [ "$(eww get lmsg)" = "$1" ] && eww update lmsg=""', "sh", text],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def app_name(apps, ident):
    if canon(ident) in BUILTIN:
        return BUILTIN[canon(ident)]
    return next((a["name"] for a in apps if a["id"].lower() == ident.lower() or canon(a["id"]) == canon(ident)), ident)


def refresh_launcher(apps):
    """Re-push what the open launcher lists, so the pinned / dock marks follow a change."""
    eww(pinned=json.dumps(resolve_pinned(apps), separators=(",", ":")))
    q = eww_get("query")
    if q.strip():
        eww(results=json.dumps(search(apps, q), separators=(",", ":")))


def eww(**kv):
    for k, v in kv.items():
        subprocess.run(["eww", "update", f"{k}={v}"], check=False)


def close_dash():
    subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "dash"), "close"], check=False)


def launch(ident):
    q = shlex.quote(ident)
    subprocess.run(["swaymsg", "-q", "exec", f"gtk-launch {q} || gtk4-launch {q}"], check=False)
    close_dash()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    arg = argv[2] if len(argv) > 2 else ""
    apps = load()
    if cmd == "search":
        res = json.dumps(search(apps, arg), separators=(",", ":"))
        eww(query=arg, results=res, sel=0)
        # Left and Right choose a pinned app while the search is empty; once you type they belong to the text field
        if subprocess.run("eww active-windows | grep -q '^launcher:'", shell=True).returncode == 0:
            subprocess.run(["swaymsg", "-q", "mode", "launcher" if arg else "launcher-pinned"], check=False)
        if sys.stdout.isatty():
            print(res)
    elif cmd == "run":
        res = search(apps, arg)
        if res:
            launch(res[0]["id"])
    elif cmd == "launch":
        launch(unquote(arg))
    elif cmd == "nav":
        items = launcher_items()
        if items:
            try:
                sel = int(eww_get("sel"))
            except ValueError:
                sel = 0
            eww(sel=(sel + (1 if arg in ("next", "right") else -1)) % len(items))
    elif cmd == "accept":
        items = launcher_items()
        if items:
            try:
                sel = int(eww_get("sel"))
            except ValueError:
                sel = 0
            launch(items[sel if 0 <= sel < len(items) else 0]["id"])
    elif cmd == "pinned":
        res = json.dumps(resolve_pinned(apps), separators=(",", ":"))
        eww(pinned=res)
        if sys.stdout.isatty():
            print(res)
    elif cmd == "toggle-pin":
        arg = unquote(arg)
        cur = [p for p in pins()]
        low = [p.lower() for p in cur]
        name = app_name(apps, arg)
        if arg.lower() in low:
            cur = [p for p in cur if p.lower() != arg.lower()]
            msg = f"unpinned {name}"
        elif len(resolve_pinned(apps)) >= MAX_PINNED:
            say(f"the launcher holds {MAX_PINNED} pinned apps: unpin one first")
            return 0
        else:
            cur = [a["id"] for a in resolve_pinned(apps)] + [arg]
            msg = f"pinned {name} to the launcher"
        os.makedirs(os.path.dirname(PINS), exist_ok=True)
        with open(PINS, "w") as f:
            f.write("\n".join(cur) + "\n")
        refresh_launcher(apps)
        say(msg)
    elif cmd == "dock":
        print(json.dumps(dock_items(apps), separators=(",", ":")))
    elif cmd == "dock-sync":
        eww(dock_apps=json.dumps(dock_items(apps), separators=(",", ":")))
    elif cmd == "dock-toggle":
        c = canon(unquote(arg))
        cur = [canon(i) for i in dock_ids()]
        name = app_name(apps, c)
        if c.lower() in [i.lower() for i in cur]:
            cur = [i for i in cur if i.lower() != c.lower()]
            msg = f"removed {name} from the dock"
        else:
            cur.append(c)
            msg = f"added {name} to the dock"
        os.makedirs(os.path.dirname(DOCK), exist_ok=True)
        with open(DOCK, "w") as f:
            f.write("\n".join(cur) + "\n")
        eww(dock_apps=json.dumps(dock_items(apps), separators=(",", ":")))
        # the open launcher shows which apps are pinned or in the dock: refresh what it lists, and confirm
        refresh_launcher(apps)
        say(msg)
    else:
        sys.stderr.write(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
