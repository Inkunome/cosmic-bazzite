#!/bin/bash
# The layout of the whole workspace (horizontal, vertical, tabbed or stacked): the third fixed item of the dock (after the launcher and the dashboard) and Super+Shift+G.
#   wslayout get [OUTPUT] print h, v, t or s for the visible workspace of a screen (default: the first one)
#   wslayout all          the layout of every screen, as JSON
#   wslayout set OUTPUT h|v|t|s   lay the visible workspace of that screen out that way (the focus stays where it was);
#                         OUTPUT can be . for the screen with the focus
#   wslayout watch        keep the dock item current (started by sway)
#   wslayout win h|v|t|s  the focused window gets its own group with that layout (new windows open inside it)
#   wslayout pop          open the picker under the pointer with the keys H V T S for the focused window (Super+G)
#   wslayout reapply [OUTPUT]   take every window of the screen's workspace out of its groups and lay them out again with
#                         the screen's layout (Super+Shift+G; . = the screen with the focus)
#   wslayout pointer OUTPUT MONITOR   print the pointer position (x y) in the coordinates of that screen's free area
here=$(readlink -f "$0"); dir=$(dirname "$here")

# The layout of a screen is the layout of the container that holds its windows: sway puts them in one container under the
# workspace (a tabbed one with workspace_layout tabbed), and that is the one we read and set. A workspace whose windows sit
# directly in it (or in several groups side by side) uses the workspace's own layout.
# every screen's layout: {"HDMI-A-1":"h","DP-3":"t"} (the visible workspace of each screen)
all() {
    swaymsg -t get_tree -r | jq -c '[.nodes[] | select(.type == "output" and .name != "__i3") | . as $o
        | ([$o.nodes[]? | select(.type == "workspace" and .name == $o.current_workspace)][0]) as $ws
        | (if ($ws.nodes | length) == 1 and ($ws.nodes[0].pid == null) then $ws.nodes[0] else $ws end).layout as $l
        | {($o.name): ($l // "splith" | if . == "splith" then "h" elif . == "splitv" then "v" elif . == "tabbed" then "t" elif . == "stacked" then "s" else "h" end)}] | add'
}

get() { all | jq -r --arg o "${1:-}" 'if $o != "" then .[$o] // "h" else (to_entries[0].value) end'; }

# Lay the visible workspace of a screen out. sway's `layout` acts on the PARENT of the focused node, so to set the layout of
# the container that holds the windows we focus its first child (a window or a group) and run `layout`, then give the focus
# back to the window that had it.
set_layout() {
    local out=$1 cmd id child
    [[ $out == . ]] && out=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused) | .name')   # "." = the screen with the focus
    case $2 in h) cmd=splith ;; v) cmd=splitv ;; t) cmd=tabbed ;; s) cmd=stacking ;; *) echo "usage: wslayout set OUTPUT h|v|t|s" >&2; return 1 ;; esac
    id=$(swaymsg -t get_tree -r | jq '[.. | objects | select(.focused? == true)][0].id')
    child=$(swaymsg -t get_tree -r | jq -r --arg o "$out" '
        .nodes[] | select(.type == "output" and .name == $o) | . as $o
        | [$o.nodes[]? | select(.type == "workspace" and .name == $o.current_workspace)][0] as $ws
        | (if ($ws.nodes | length) == 1 and ($ws.nodes[0].pid == null) then $ws.nodes[0] else $ws end) | .nodes[0].id // empty')
    if [[ -n $child ]]; then
        swaymsg -q "[con_id=$child] focus"
        swaymsg -q "layout $cmd"
    else
        swaymsg -q "focus output $out"; swaymsg -q "layout $cmd"   # an empty workspace
    fi
    [[ -n $id && $id != null ]] && swaymsg -q "[con_id=$id] focus"
    eww update wslay="$(all)" >/dev/null 2>&1
}

# Re-apply the global layout of a screen: take every window of its visible workspace out of whatever groups they were in,
# put them back one after the other in the same order, and lay the workspace out again with the layout the screen has.
# Windows come out of their nested groups by a trip through a hidden workspace (sway has no command to flatten).
reapply() {
    local out=$1 layout ws ids id focus tmp=ink-reflow
    [[ $out == . ]] && out=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused) | .name')
    layout=$(get "$out")
    ws=$(swaymsg -t get_workspaces -r | jq -r --arg o "$out" '.[] | select(.output == $o and .visible) | .name')
    [[ -n $ws ]] || return 1
    # the tiled windows of that workspace in tree order (floating ones stay where they are)
    mapfile -t ids < <(swaymsg -t get_tree -r | jq -r --arg w "$ws" '
        def leaves: if (.pid? != null and .pid != null) then .id else (.nodes[]? | leaves) end;
        [.. | objects | select(.type? == "workspace" and .name == $w)][0] | .nodes[]? | leaves')
    ((${#ids[@]} > 1)) || { set_layout "$out" "$layout"; return; }
    focus=$(swaymsg -t get_tree -r | jq '[.. | objects | select(.focused? == true)][0].id')
    swaymsg -q "focus output $out"
    for id in "${ids[@]}"; do swaymsg -q "[con_id=$id] move container to workspace $tmp"; done
    # a window lands next to the active one of the workspace: focus each as it arrives, so they keep their order
    for id in "${ids[@]}"; do swaymsg -q "[con_id=$id] move container to workspace \"$ws\""; swaymsg -q "[con_id=$id] focus"; done
    set_layout "$out" "$layout"
    [[ -n $focus && $focus != null ]] && swaymsg -q "[con_id=$focus] focus"
    eww update wslay="$(all)" >/dev/null 2>&1
}

# the layout of the focused window itself: it goes into its own group with that layout, so only this window is affected
# and the next windows opened from it land inside the group (sway has no layout for a single window: a split wraps it)
win_layout() {
    case $1 in
        h) swaymsg -q "splith" ;;
        v) swaymsg -q "splitv" ;;
        t) swaymsg -q "splith; layout tabbed" ;;
        s) swaymsg -q "splith; layout stacking" ;;
        *) echo "usage: wslayout win h|v|t|s" >&2; return 1 ;;
    esac
}

case "${1:-get}" in
    get) get "${2:-}" ;;
    all) all ;;
    set) set_layout "${2:-}" "${3:-}" ;;
    watch)
        eww update wslay="$(all)" >/dev/null 2>&1
        swaymsg -t subscribe -m '["window","workspace","output"]' | while read -r _; do
            while read -r -t 0.3 _; do :; done
            eww update wslay="$(all)" >/dev/null 2>&1
        done ;;
    reapply) reapply "${2:-.}" ;;
    win) win_layout "${2:-}"; eww update wslay="$(all)" >/dev/null 2>&1 ;;
    apply) if [[ $(eww get lay_scope) == win ]]; then win_layout "${3:-}"; eww update wslay="$(all)" >/dev/null 2>&1; else set_layout "${2:-}" "${3:-}"; fi ;;
    pointer)
        # where the pointer is, in the coordinates of the free area of screen $2 (eww monitor $3): "x y", or nothing
        rm -f "${XDG_RUNTIME_DIR:-/tmp}/ink-ptr"
        eww open ptrprobe --arg "mon=${3:-0}" >/dev/null 2>&1
        # a surface that appears under a motionless pointer is not told about it: move the pointer one pixel and back
        sleep 0.15
        if [[ ! -s ${XDG_RUNTIME_DIR:-/tmp}/ink-ptr ]]; then swaymsg -q -- seat - cursor move 1 0; swaymsg -q -- seat - cursor move -1 0; fi
        for _ in 1 2 3 4 5 6 7 8; do [[ -s ${XDG_RUNTIME_DIR:-/tmp}/ink-ptr ]] && break; sleep 0.06; done
        eww close ptrprobe >/dev/null 2>&1
        cat "${XDG_RUNTIME_DIR:-/tmp}/ink-ptr" 2>/dev/null ;;
    pop)
        # the picker of Super+G opens under the pointer (centred on it, kept on the screen); it is for the focused window
        read -r out w h < <(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused) | "\(.name) \(.rect.width) \(.rect.height)"')
        mon=$("$dir/screens" map | awk -v o="$out" '$1 == o {print $2}'); mon=${mon:-0}
        scope=win; mode=winlayout
        read -r px py < <("$here" pointer "$out" "$mon")
        # the size of the free area (what the bar, strip and dock leave): the workspace rect plus its gaps
        read -r aw ah < <(swaymsg -t get_workspaces -r | jq -r --arg o "$out" '[.[] | select(.output == $o and .visible)][0].rect | "\(.width + 24) \(.height + 24)"')
        aw=${aw:-$w}; ah=${ah:-$h}
        PW=600 PH=240
        px=${px%.*}; py=${py%.*}
        [[ -n $px && -n $py ]] || { px=$((aw / 2)); py=$((ah / 2 - PH / 2)); }
        x=$((px - PW / 2)); ((x < 8)) && x=8; ((x > aw - PW - 8)) && x=$((aw - PW - 8))
        y=$((py + 14)); ((y + PH > ah - 8)) && y=$((py - PH - 14)); ((y < 8)) && y=8
        eww update lay_pill=true lay_scope=$scope >/dev/null 2>&1
        eww open layoutpop-ptr --arg "mon=$mon" --arg "out=$out" --pos "${x}x${y}" >/dev/null 2>&1
        # the keys only if the picker really is there (it can take a moment to show)
        for _ in 1 2 3 4 5 6 7 8; do
            eww active-windows 2>/dev/null | grep -q "^layoutpop-ptr:" && { swaymsg -q mode "$mode"; break; }
            sleep 0.15
        done ;;
    close) eww update lay_pill=false lay_pop=false lay_scope=ws >/dev/null 2>&1; eww close layoutpop-dock layoutpop-strip layoutpop-ptr >/dev/null 2>&1; swaymsg -q mode default ;;
    *) sed -n '2,7p' "$0" >&2; exit 1 ;;
esac
exit 0
