#!/bin/bash
# power <lock|suspend|logout|reboot|poweroff>
# logout, reboot and poweroff need a second click within 4 seconds.
act=${1:-}
case $act in
    lock) eww close quick; exec ink-lock ;;
    suspend) eww close quick; exec systemctl suspend ;;
    logout|reboot|poweroff)
        if [[ $(eww get pwr_confirm) == "$act" ]]; then
            eww update pwr_confirm=
            case $act in
                logout) exec swaymsg exit ;;
                reboot) exec systemctl reboot ;;
                poweroff) exec systemctl poweroff ;;
            esac
        else
            eww update pwr_confirm="$act"
            ( sleep 4; [[ $(eww get pwr_confirm) == "$act" ]] && eww update pwr_confirm= ) >/dev/null 2>&1 &
        fi ;;
    *) echo "usage: power lock|suspend|logout|reboot|poweroff" >&2; exit 1 ;;
esac
