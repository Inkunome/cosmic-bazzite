#!/bin/bash
# Launcher / dashboard control.
#   dash toggle launcher    app launcher: search + pinned apps      (Ctrl+Space, Super+D)
#   dash toggle dashboard   time, system, media, toggles, calendar  (Alt+Space, dock icon)
#   dash toggle expose      every workspace and window as thumbnails         (Super+Tab)
#   dash open <kind> | dash close
# Each kind has a wide layout (landscape screens) and a long one (portrait screens), chosen from
# the shape of the focused output. Only one is open at a time. While one is open, sway is in the
# "dash" binding mode so Escape, Ctrl+Space and Alt+Space close it.
here=$(dirname "$(readlink -f "$0")")
is_open() { eww active-windows 2>/dev/null | grep -q '^dashboard:\|^launcher:\|^expose:'; }
open_kind() {
    local kind=$1 idx w h
    [[ $kind == launcher || $kind == dashboard || $kind == expose ]] || { echo "usage: dash open launcher|dashboard|expose" >&2; return 1; }
    eww close dashboard launcher expose >/dev/null 2>&1
    if [[ $kind == launcher ]]; then
        eww update query="" results="[]" sel=0
        "$here/apps" pinned >/dev/null
    fi
    # monitor index among the active outputs (eww 0.6 takes an index, not sway's output name)
    read -r idx w h < <(swaymsg -t get_outputs -r | jq -r '[.[] | select(.active)] | to_entries | (map(select(.value.focused))[0] // .[0]) | "\(.key) \(.value.rect.width) \(.value.rect.height)"')
    if [[ $kind == expose ]]; then "$here/expose" refresh; eww open expose --id expose --arg "mon=$idx"
    elif ((h > w)); then eww open "$kind-long" --id "$kind" --arg "mon=$idx"
    else eww open "$kind-wide" --id "$kind" --arg "mon=$idx"; fi
    # the launcher also owns Up, Down, Tab and Return (see the "launcher" mode in the sway config)
    if [[ $kind == launcher ]]; then swaymsg -q mode launcher; else swaymsg -q mode dash; fi
}
# which kind is open right now (empty when none)
current() { eww active-windows 2>/dev/null | sed -n 's/^\(dashboard\|launcher\|expose\): .*/\1/p' | head -1; }
case "${1:-toggle}" in
    open) open_kind "${2:-launcher}" ;;
    close) eww close dashboard launcher expose >/dev/null 2>&1; swaymsg -q mode default ;;
    toggle)
        kind=${2:-launcher}
        if [[ $(current) == "$kind" ]]; then "$here/dash" close; else open_kind "$kind"; fi ;;
    *) echo "usage: dash toggle|open <launcher|dashboard> | dash close" >&2; exit 1 ;;
esac
exit 0
