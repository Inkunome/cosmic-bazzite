;; Ink bar — workspaces | clock | layout, stats, tray
(deflisten workspaces :initial "[]" "~/.config/eww/scripts/workspaces")
(deflisten scratch :initial "[]" "ink-scratch watch")
(deflisten media :initial "{\"status\":\"Stopped\",\"artist\":\"\",\"title\":\"\"}" "~/.config/eww/scripts/media")
(deflisten layout :initial "qwerty" "ink-layout watch")
(defpoll sink :interval "1s" :initial "{\"vol\":0,\"muted\":false}" "~/.config/eww/scripts/audio sink")
(defpoll adev :interval "2s" :run-while {vol_pill || vol_pop} :initial "{\"sinks\":[],\"sources\":[]}" "~/.config/eww/scripts/audio devices")
(defpoll src :interval "1s" :initial "{\"vol\":0,\"muted\":false}" "~/.config/eww/scripts/audio source")
(defpoll nt :interval "2s" :initial "{\"dnd\":false,\"count\":0,\"items\":[]}" "~/.config/eww/scripts/notifs")
(defpoll uptime :interval "60s" "uptime -p | sed 's/^up //'")
;; hover state for the flyouts (a flyout closes only when neither its pill nor itself is hovered)
(defvar sys_pill false)
(defvar sys_pop false)
(defvar vol_pill false)
(defvar vol_pop false)
(defvar nt_pill false)
(defvar nt_pop false)
(defvar cal_pill false)
(defvar cal_pop false)
(defvar expose "[]")
(defvar vol_sink_v 0)
(defvar vol_source_v 0)
(defvar query "")
(defvar sel 0)
(defvar results "[]")
(defvar pinned "[]")
(defvar keys_pill false)
(defvar keys_pop false)
(defvar qs_pill false)
(defvar qs_pop false)
(defvar pwr_confirm "")
(defpoll qs :interval "3s" :initial "{\"wifi\":false,\"ssid\":\"\",\"bt\":false,\"dnd\":false,\"night\":false,\"profile\":\"unknown\",\"bright\":-1}" "~/.config/eww/scripts/qs")
(defpoll clock :interval "10s" "date '+%a %d %b  %H:%M'")

(defwidget bar-content [mon]
  (centerbox :class "bar" :orientation "h"
    (box :halign "start" :space-evenly false
      (for ws in workspaces
        (button :timeout "10s" :class "ws ${ws.focused ? 'focused' : ws.visible ? 'visible' : ''} ${ws.urgent ? 'urgent' : ''}"
                :onclick "swaymsg workspace ${ws.name}"
          {ws.focused ? "◉ ${ws.name}" : "○ ${ws.name}"})))
    (box :halign "center"
      (eventbox :timeout "10s" :onhover "eww update cal_pill=true && eww open cal --arg mon=${mon}"
                :onhoverlost "eww update cal_pill=false && ~/.config/eww/scripts/popclose cal cal"
        (label :class "pill clock" :text clock)))
    (box :halign "end" :space-evenly false
      (eventbox :timeout "10s" :onhover "eww update keys_pill=true && eww open keys --arg mon=${mon}"
                :onhoverlost "eww update keys_pill=false && ~/.config/eww/scripts/popclose keys keys"
        (button :timeout "10s" :class "pill layout" :onclick "ink-layout next" :onrightclick "ink-layout prev"
          {"⌨ ${layout == 'bepo' ? 'BÉPO' : layout == 'azerty' ? 'AZERTY' : 'QWERTY'}"}))
      (eventbox :timeout "10s" :onhover "eww update sys_pill=true && eww open sysinfo --arg mon=${mon}"
                :onhoverlost "eww update sys_pill=false && ~/.config/eww/scripts/popclose sysinfo sys"
        (box :class "pill" :tooltip "cpu ${round(EWW_CPU.avg, 0)}% · ram ${round(EWW_RAM.used_mem_perc, 0)}%"
          (image :path "${EWW_CONFIG_DIR}/icons/cpu.svg" :image-width 18 :image-height 18)))
      (eventbox :timeout "10s" :onhover "eww update vol_pill=true && eww open volpop --arg mon=${mon}; ~/.config/eww/scripts/audio sync"
                :onhoverlost "eww update vol_pill=false && ~/.config/eww/scripts/popclose volpop vol"
                :onscroll "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%{}"
                :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        (box :class "pill vol ${sink.muted ? 'muted' : ''}" :tooltip {sink.muted ? "muted" : "volume ${sink.vol}%"}
          (image :path {"${EWW_CONFIG_DIR}/icons/" + (sink.muted ? "vol-muted" : sink.vol < 34 ? "vol-low" : "vol-high") + ".svg"}
                 :image-width 18 :image-height 18)))
      (eventbox :timeout "10s" :onhover "eww update nt_pill=true && eww open notifs --arg mon=${mon}"
                :onhoverlost "eww update nt_pill=false && ~/.config/eww/scripts/popclose notifs nt"
                :onclick "makoctl mode -t do-not-disturb; eww poll nt"
        (box :class "pill" :tooltip {nt.dnd ? "do not disturb" : nt.count > 0 ? "${nt.count} notification(s)" : "no notifications"}
          (image :path {"${EWW_CONFIG_DIR}/icons/" + (nt.dnd ? "bell-off" : nt.count > 0 ? "bell-dot" : "bell") + ".svg"}
                 :image-width 18 :image-height 18)))
      (label :class "pill bat ${EWW_BATTERY == '' ? '' : 'show'}"
             :visible {EWW_BATTERY != ""}
             :text "bat ${EWW_BATTERY == '' ? '' : EWW_BATTERY.total_avg}%")
      (systray :class "pill" :icon-size 16 :spacing 6)
      (eventbox :timeout "10s" :onhover "eww update qs_pill=true && eww open quick --arg mon=${mon}"
                :onhoverlost "eww update qs_pill=false && ~/.config/eww/scripts/popclose quick qs"
        (box :class "pill qs" (image :path "${EWW_CONFIG_DIR}/icons/paw.svg" :image-width 18 :image-height 18))))))

;; A brown thorny branch with flowers and a rose runs along the bottom edge of the bar.
;; It sits below the bar, so it never covers any widget.
(defwidget bar [mon]
  (box :orientation "v" :space-evenly false
    (box :class "bar-pad" (bar-content :mon mon))
    (box :class "vine" :height 16
         :style "background-image: url('${EWW_CONFIG_DIR}/icons/vine-bottom.svg');")))

(defwindow bar [mon]
  :monitor mon
  :geometry (geometry :x "0%" :y "6px" :width "98%" :height "54px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "ink-bar"
  (bar :mon mon))

;; Bottom strip — landscape screens only. Minimised windows (sway scratchpad) on the left, the media player on the right.
;; It reserves its own height at the bottom edge, so windows stop above it instead of running to the bottom of the screen.
(defwidget strip []
  (box :orientation "v" :space-evenly false
    (box :class "strip" :orientation "h" :space-evenly false :height 36
      (box :orientation "h" :space-evenly false :halign "start" :hexpand true :spacing 6
        (label :class "dim" :visible {arraylength(scratch) == 0} :text "Alt+Esc minimises a window here")
        (for w in scratch
          (button :timeout "10s" :class "strip-win" :tooltip {w.name} :onclick "ink-scratch show ${w.id}"
            (label :limit-width 24 :text "${w.initial}  ${w.name}"))))
      (box :class "strip-player" :orientation "h" :space-evenly false :halign "end" :spacing 8
        (label :class "strip-track" :limit-width 48
               :text {media.title != "" ? (media.artist != "" ? "${media.artist} — ${media.title}" : media.title) : "nothing playing"})
        (button :timeout "10s" :class "strip-btn" :onclick "playerctl previous" "‹")
        (button :timeout "10s" :class "strip-btn" :onclick "playerctl play-pause" {media.status == "Playing" ? "❚❚" : "▶"})
        (button :timeout "10s" :class "strip-btn" :onclick "playerctl next" "›")))))

(defwindow strip [mon]
  :monitor mon
  ;; 36 px tall
  :geometry (geometry :x "0%" :y "6px" :width "98%" :height "36px" :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  :namespace "ink-bar"
  (strip))

;; Workspaces of a portrait screen (it has no bar), to the left of the dock and as tall as the dock. Only this screen's workspaces.
(defwidget wsdock [out]
  (box :class "wsdock" :orientation "h" :space-evenly false :halign "start" :valign "fill"
    (for ws in workspaces
      (button :timeout "10s" :visible {ws.output == out}
              :class "ws ${ws.focused ? 'focused' : ws.visible ? 'visible' : ''} ${ws.urgent ? 'urgent' : ''}"
              :onclick "swaymsg workspace ${ws.name}"
        {ws.name}))))

(defwindow ws-dock [mon out]
  :monitor mon
  ;; same height and bottom edge as the dock and the clock (y is negative for the same reason as the clock's)
  :geometry (geometry :x "24px" :y "-76px" :height "76px" :anchor "bottom left")
  :stacking "fg"
  :exclusive false
  :namespace "ink-dock"
  (wsdock :out out))

;; Dock — pinned apps. Shown only on portrait screens, centred at the bottom (landscape screens get the bar instead). Icons are Ink-styled SVGs in ~/.config/eww/icons.
(defwidget dock-app [app tip]
  (button :timeout "10s" :class "dock-icon" :tooltip tip :onclick "~/.config/eww/scripts/launch ${app} &"
    (image :path "${EWW_CONFIG_DIR}/icons/${app}.svg" :image-width 44 :image-height 44)))

(defwidget dock []
  (box :class "dock" :orientation "h" :space-evenly false
    ;; minimised windows (sway scratchpad): click to bring one back
    (box :orientation "h" :space-evenly false :visible {arraylength(scratch) > 0}
      (for w in scratch
        (button :timeout "10s" :class "dock-icon mini" :tooltip {w.name} :onclick "ink-scratch show ${w.id}"
          (label :text {w.initial})))
      (box :class "dock-sep" :width 2))
    (dock-app :app "dashboard" :tip "Dashboard")
    (dock-app :app "browser" :tip "Firefox")
    (dock-app :app "terminal" :tip "Terminal")
    (dock-app :app "files" :tip "Files")
    (dock-app :app "settings" :tip "Settings")))

(defwidget bigclock []
  (box :class "bigclock" :valign "fill" :halign "fill"
    (label :class "bigclock-time" :hexpand true :vexpand true :text {formattime(EWW_TIME, "%H:%M")})))

;; The big clock sits at the bottom right of a portrait screen, to the right of the dock, and is as tall as the dock.
;; It shows only the time: a portrait screen has no bar, so this is where its time is.
(defwindow clock-big [mon]
  :monitor mon
  ;; a fixed size: sized from its content, the window would be laid out before the time has a value and keep that width.
  ;; y is negative because the dock reserves its own height at the bottom edge and this window is placed above that zone:
  ;; -76 px brings its bottom edge level with the dock (16 px from the screen edge).
  :geometry (geometry :x "24px" :y "-76px" :width "180px" :height "76px" :anchor "bottom right")
  :stacking "fg"
  :exclusive false
  :namespace "ink-dock"
  (bigclock))

(defwindow dock [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "16px" :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  :namespace "ink-dock"
  (dock))

;; ── Flyouts ──────────────────────────────────────────────
;; Open on hover over their pill in the bar, close shortly after the pointer leaves both.
(defwidget meter [label value]
  (box :class "meter" :orientation "v" :space-evenly false
    (box :space-evenly false
      (label :class "dim" :halign "start" :hexpand true :text label)
      (label :halign "end" :text "${round(value, 0)}%"))
    (progress :value value :class "bar-meter")))

(defwidget sysinfo []
  (eventbox :timeout "10s" :onhover "eww update sys_pop=true"
            :onhoverlost "eww update sys_pop=false && ~/.config/eww/scripts/popclose sysinfo sys"
    (box :class "pop" :orientation "v" :space-evenly false :spacing 10
      :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
      (label :class "pop-title" :halign "start" :text "system")
      (meter :label "cpu" :value {EWW_CPU.avg})
      (meter :label "ram  ${round(EWW_RAM.used_mem / 1073741824, 1)} / ${round(EWW_RAM.total_mem / 1073741824, 1)} GB" :value {EWW_RAM.used_mem_perc})
      (meter :label "disk /" :value {EWW_DISK["/"].used_perc})
      (label :class "dim" :halign "start" :text "up ${uptime}"))))

(defwidget slider-row [name kind data val]
  (box :class "meter" :orientation "v" :space-evenly false
    (box :space-evenly false
      (button :timeout "10s" :class "pop-btn ${data.muted ? 'muted' : ''}" :halign "start" :hexpand true
              :onclick "~/.config/eww/scripts/audio mute ${kind}"
        {data.muted ? "${name} (muted)" : name})
      ;; the number comes from the same variable the slider writes, so it moves with the slider
      (label :halign "end" :text "${round(val, 0)}%"))
    (scale :timeout "10s" :class "slider" :min 0 :max 101 :value val
           :onchange "~/.config/eww/scripts/audio set ${kind} {}")))

;; pick the default device: the current one is marked
(defwidget devices [kind items]
  (box :orientation "v" :space-evenly false :spacing 2
    (for d in items
      (button :timeout "10s" :class "dev ${d.default ? 'selected' : ''}"
              :onclick "~/.config/eww/scripts/audio default ${kind} '${d.name}'"
        (label :halign "start" :limit-width 42 :text "${d.default ? '●' : '○'}  ${d.desc}")))))

(defwidget volpop []
  (eventbox :timeout "10s" :onhover "eww update vol_pop=true"
            :onhoverlost "eww update vol_pop=false && ~/.config/eww/scripts/popclose volpop vol"
    (box :class "pop" :orientation "v" :space-evenly false :spacing 10
      :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
      (slider-row :name "speakers" :kind "sink" :data sink :val vol_sink_v)
      (devices :kind "sink" :items {adev.sinks})
      (slider-row :name "microphone" :kind "source" :data src :val vol_source_v)
      (devices :kind "source" :items {adev.sources}))))

(defwindow sysinfo [mon]
  :monitor mon
  :geometry (geometry :x "260px" :y "4px" :width "280px" :anchor "top right")
  :stacking "overlay"
  :namespace "ink-pop"
  (sysinfo))

(defwindow volpop [mon]
  :monitor mon
  :geometry (geometry :x "110px" :y "4px" :width "380px" :anchor "top right")
  :stacking "overlay"
  :namespace "ink-pop"
  (volpop))

;; ── Quick settings (top-right menu) ──────────────────────
;; Everything needed day to day: network, bluetooth, notifications, night light,
;; power profile, brightness, system apps and the power menu.
(defwidget tile [label sub on action]
  (button :timeout "10s" :class "tile ${on ? 'on' : ''}"
          :onclick "~/.config/eww/scripts/toggle ${action}; eww poll qs"
    (box :orientation "v" :space-evenly false :halign "start"
      (label :class "tile-label" :halign "start" :text label)
      (label :class "dim" :halign "start" :limit-width 14 :text sub))))

(defwidget app [label cmd]
  (button :timeout "10s" :class "app" :onclick "eww close quick; ${cmd} &" label))

(defwidget pbtn [label action]
  (button :timeout "10s" :class "pbtn ${pwr_confirm == action ? 'confirm' : ''}"
          :onclick "~/.config/eww/scripts/power ${action}"
    {pwr_confirm == action ? "sure?" : label}))

(defwidget quick []
  (eventbox :timeout "10s" :onhover "eww update qs_pop=true"
            :onhoverlost "eww update qs_pop=false && ~/.config/eww/scripts/popclose quick qs"
    (box :class "pop" :orientation "v" :space-evenly false :spacing 12
      :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
      (label :class "pop-title" :halign "start" :text "quick settings")
      (box :orientation "v" :space-evenly false :spacing 8
        (box :spacing 8
          (tile :label "Wi-Fi" :sub {qs.wifi ? (qs.ssid != "" ? qs.ssid : "on") : "off"} :on {qs.wifi} :action "wifi")
          (tile :label "Bluetooth" :sub {qs.bt ? "on" : "off"} :on {qs.bt} :action "bluetooth"))
        (box :spacing 8
          (tile :label "Do not disturb" :sub {qs.dnd ? "on" : "off"} :on {qs.dnd} :action "dnd")
          (tile :label "Night light" :sub {qs.night ? "on" : "off"} :on {qs.night} :action "night"))
        (box :spacing 8
          (tile :label "Power profile" :sub {qs.profile} :on {qs.profile == "performance"} :action "profile")
          (box :hexpand true)))
      (box :orientation "v" :space-evenly false :visible {qs.bright >= 0}
        (box :space-evenly false
          (label :class "dim" :halign "start" :hexpand true :text "brightness")
          (label :halign "end" :text "${qs.bright}%"))
        (scale :timeout "10s" :class "slider" :min 1 :max 101 :value {qs.bright >= 0 ? qs.bright : 50}
               :onchange "brightnessctl -q set {}%"))
      (label :class "pop-title" :halign "start" :text "settings")
      (box :orientation "v" :space-evenly false :spacing 4
        (box :spacing 4
          (app :label "Network" :cmd "nm-connection-editor")
          (app :label "Bluetooth" :cmd "blueman-manager")
          (app :label "Sound" :cmd "pavucontrol"))
        (box :spacing 4
          (app :label "Displays" :cmd "wdisplays")
          (app :label "Printers" :cmd "system-config-printer")
          (app :label "Dashboard" :cmd "~/.config/eww/scripts/dash toggle dashboard"))
        (box :spacing 4
          (app :label "Screenshot" :cmd "ink-screenshot menu")
          (app :label "Clipboard" :cmd "sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'")
          (app :label "Files" :cmd "thunar")))
      (label :class "pop-title" :halign "start" :text "power")
      (box :spacing 4 :space-evenly false
        (pbtn :label "Lock" :action "lock")
        (pbtn :label "Sleep" :action "suspend")
        (pbtn :label "Log out" :action "logout")
        (pbtn :label "Reboot" :action "reboot")
        (pbtn :label "Shut down" :action "poweroff")))))

(defwindow quick [mon]
  :monitor mon
  :geometry (geometry :x "12px" :y "4px" :width "400px" :anchor "top right")
  :stacking "overlay"
  :namespace "ink-pop"
  (quick))

;; ── Notification centre (bell in the bar) ────────────────
;; Click the bell to toggle do-not-disturb; hover for the recent notifications.
(defwidget notif-item [app summary body]
  (box :class "notif" :orientation "v" :space-evenly false
    (label :class "dim" :halign "start" :limit-width 34 :text app)
    (label :halign "start" :limit-width 34 :text summary)
    (label :class "dim" :halign "start" :limit-width 34 :visible {body != ""} :text body)))

(defwidget notifs []
  (eventbox :timeout "10s" :onhover "eww update nt_pop=true"
            :onhoverlost "eww update nt_pop=false && ~/.config/eww/scripts/popclose notifs nt"
    (box :class "pop" :orientation "v" :space-evenly false :spacing 10
      :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
      (box :space-evenly false
        (label :class "pop-title" :halign "start" :hexpand true :text "notifications")
        (button :timeout "10s" :class "pop-btn ${nt.dnd ? 'muted' : ''}" :onclick "makoctl mode -t do-not-disturb; eww poll nt"
          {nt.dnd ? "do not disturb: on" : "do not disturb: off"}))
      (box :orientation "v" :space-evenly false :spacing 6 :visible {arraylength(nt.items) > 0}
        (for n in {nt.items}
          (notif-item :app {n.app} :summary {n.summary} :body {n.body})))
      (label :class "dim" :halign "start" :visible {arraylength(nt.items) == 0} :text "nothing yet")
      (box :spacing 4
        (button :timeout "10s" :class "app" :onclick "~/.config/eww/scripts/notifs clear; eww poll nt" "Clear all")
        (button :timeout "10s" :class "app" :onclick "makoctl restore; eww poll nt" "Restore last")))))

(defwindow notifs [mon]
  :monitor mon
  :geometry (geometry :x "180px" :y "4px" :width "320px" :anchor "top right")
  :stacking "overlay"
  :namespace "ink-pop"
  (notifs))

;; ── Shortcut sheet (hover the keyboard layout in the bar) ─
(defwidget keyrow [keys desc]
  (box :space-evenly false :spacing 8
    (box :class "keycol" :space-evenly false :spacing 3 :halign "start"
      (for k in keys (label :class "keycap" :text k)))
    (label :class "dim keydesc" :halign "start" :hexpand true :limit-width 28 :text desc)))

(defwidget keys []
  (eventbox :timeout "10s" :onhover "eww update keys_pop=true"
            :onhoverlost "eww update keys_pop=false && ~/.config/eww/scripts/popclose keys keys"
    (box :class "pop" :orientation "v" :space-evenly false :spacing 10
      :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
      (box :space-evenly false
        (label :class "pop-title" :halign "start" :hexpand true :text "shortcuts")
        (label :class "dim" :halign "end" :text "Super = the Windows key"))
      (box :spacing 24 :valign "start"
        (box :orientation "v" :space-evenly false :spacing 5 :valign "start"
          (label :class "pop-title" :halign "start" :text "apps")
          (keyrow :keys {["Super", "Shift", "Return"]} :desc "terminal")
          (keyrow :keys {["Super", "T"]} :desc "zellij")
          (keyrow :keys {["Super", "Ctrl", "Space"]} :desc "spellbook")
          (keyrow :keys {["Ctrl", "Space"]} :desc "app launcher")
          (keyrow :keys {["Super", "D"]} :desc "app launcher")
          (keyrow :keys {["Alt", "Space"]} :desc "dashboard")
          (keyrow :keys {["Super", "C"]} :desc "clipboard")
          (label :class "pop-title" :halign "start" :text "capture")
          (keyrow :keys {["Super", "S"]} :desc "area → editor")
          (keyrow :keys {["Super", "Shift", "S"]} :desc "menu")
          (keyrow :keys {["Super", "Ctrl", "S"]} :desc "all screens")
          (keyrow :keys {["Super", "Alt", "S"]} :desc "window → clip")
          (label :class "pop-title" :halign "start" :text "keyboard")
          (keyrow :keys {["Super", "Space"]} :desc "next layout")
          (keyrow :keys {["Super", "Shift", "Space"]} :desc "prev layout")
          (keyrow :keys {["Super", "Ctrl", "1 2 3"]} :desc "bépo azerty qwerty"))
        (box :orientation "v" :space-evenly false :spacing 5 :valign "start"
          (label :class "pop-title" :halign "start" :text "windows")
          (keyrow :keys {["Super", "←", "↑", "↓", "→"]} :desc "focus window")
          (keyrow :keys {["Super", "Shift", "←", "↑", "↓", "→"]} :desc "move window")
          (keyrow :keys {["Super", "Return"]} :desc "fullscreen")
          (keyrow :keys {["Super", "Shift", "F"]} :desc "float")
          (keyrow :keys {["Super", "W"]} :desc "tabs")
          (keyrow :keys {["Super", "E"]} :desc "split")
          (keyrow :keys {["Super", "Shift", "Q"]} :desc "close")
          (keyrow :keys {["Ctrl", "Alt", "F"]} :desc "close window")
          (keyrow :keys {["Middle click", "tab"]} :desc "close tab")
          (keyrow :keys {["Super", "A"]} :desc "focus parent")
          (keyrow :keys {["Super", "Shift", "A"]} :desc "focus child")
          (label :class "pop-title" :halign "start" :text "minimise")
          (keyrow :keys {["Alt", "Esc"]} :desc "to the dock")
          (keyrow :keys {["Alt", "Tab"]} :desc "next hidden"))
        (box :orientation "v" :space-evenly false :spacing 5 :valign "start"
          (label :class "pop-title" :halign "start" :text "workspaces")
          (keyrow :keys {["Super", "1…9"]} :desc "go to")
          (keyrow :keys {["Super", "Shift", "1…9"]} :desc "send window")
          (keyrow :keys {["Super", "Tab"]} :desc "expose")
          (keyrow :keys {["Super", "PgUp PgDn"]} :desc "prev / next")
          (keyrow :keys {["Super", "Ctrl", "← →"]} :desc "prev / next")
          (keyrow :keys {["Super", "Shift", "PgUp PgDn"]} :desc "send + follow")
          (keyrow :keys {["Super", "Alt", "← →"]} :desc "move to screen")
          (keyrow :keys {["Super", "wheel"]} :desc "scroll")
          (label :class "pop-title" :halign "start" :text "system")
          (keyrow :keys {["Super", "L"]} :desc "lock")
          (keyrow :keys {["Super", "Shift", "E"]} :desc "power menu")
          (keyrow :keys {["Super", "Shift", "C"]} :desc "reload"))))))

(defwindow keys [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "4px" :width "1120px" :anchor "top center")
  :stacking "overlay"
  :namespace "ink-pop"
  (keys))

;; ── Calendar (hover the date in the bar) ─────────────────
(defwidget calbox []
  (eventbox :timeout "10s" :onhover "eww update cal_pop=true"
            :onhoverlost "eww update cal_pop=false && ~/.config/eww/scripts/popclose cal cal"
    (box :class "pop" :orientation "v" :space-evenly false :spacing 8
      :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
      (label :class "pop-title" :halign "start" :text {formattime(EWW_TIME, "%A %d %B %Y")})
      (calendar :class "cal" :show-heading true :show-week-numbers false))))

(defwindow cal [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "4px" :width "300px" :anchor "top center")
  :stacking "overlay"
  :namespace "ink-pop"
  (calbox))

(defwidget ring [label value]
  (box :orientation "v" :space-evenly false :spacing 4
    (circular-progress :class "ring" :value value :thickness 8 :start-at 75 :clockwise true
      (box :width 74 :height 74
        (label :text "${round(value, 0)}%")))
    (label :class "dim" :text label)))

(defwidget media-card []
  (box :class "card" :orientation "v" :space-evenly false :spacing 6
    (label :class "dim" :halign "start" :text "now playing")
    (label :halign "start" :limit-width 34 :text {media.title != "" ? media.title : "nothing playing"})
    (label :class "dim" :halign "start" :limit-width 34 :text {media.artist})
    (box :spacing 6 :halign "start"
      (button :timeout "10s" :class "app" :onclick "playerctl previous" "prev")
      (button :timeout "10s" :class "app" :onclick "playerctl play-pause" {media.status == "Playing" ? "pause" : "play"})
      (button :timeout "10s" :class "app" :onclick "playerctl next" "next"))))

(defwidget app-tile [id name icon initial selected]
  (button :timeout "10s" :class "app-tile ${selected ? 'selected' : ''}" :tooltip "${name}  (right-click: pin / unpin)"
          :onclick "~/.config/eww/scripts/apps launch ${id}"
          :onrightclick "~/.config/eww/scripts/apps toggle-pin ${id}"
    (box :orientation "v" :space-evenly false :spacing 4
      (box :class "app-icon" :halign "center"
        (image :visible {icon != ""} :path {icon} :image-width 40 :image-height 40)
        (label :visible {icon == ""} :class "app-initial" :text initial))
      (label :class "dim" :limit-width 10 :text name))))

(defwidget result-row [id name icon initial pinned selected]
  (button :timeout "10s" :class "result ${selected ? 'selected' : ''}" :onclick "~/.config/eww/scripts/apps launch ${id}"
          :onrightclick "~/.config/eww/scripts/apps toggle-pin ${id}"
    (box :space-evenly false :spacing 10
      (box :class "app-icon-sm"
        (image :visible {icon != ""} :path {icon} :image-width 28 :image-height 28)
        (label :visible {icon == ""} :class "app-initial" :text initial))
      (label :halign "start" :hexpand true :limit-width 50 :text name)
      (label :class "dim" :text {pinned ? "pinned" : ""}))))


;; ── Launcher (Ctrl+Space, Super+D): search + pinned applications ───────────
;; Wide layout for landscape screens (pinned as a row of tiles), long layout for portrait ones (pinned as a list).
;; `dash` picks the layout from the shape of the focused screen.
(defwidget launcher []
  (box :class "pop dash" :orientation "v" :space-evenly false :spacing 14
    :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
    ;; search field first: it takes the keyboard focus when the launcher opens
    (box :space-evenly false :spacing 10
      (input :class "search" :hexpand true :timeout "5s"
             :onchange "~/.config/eww/scripts/apps search '{}'"
             :onaccept "~/.config/eww/scripts/apps run '{}'")
      (button :timeout "10s" :class "pop-btn" :onclick "~/.config/eww/scripts/dash close" "close"))
    (box :orientation "v" :space-evenly false :spacing 4 :visible {query != ""}
      (for r in results
        (result-row :id {r.q} :name {r.name} :icon {r.icon} :initial {r.initial} :pinned {r.pinned} :selected {r.idx == sel}))
      (label :class "dim" :halign "start" :visible {arraylength(results) == 0} :text "no application found"))
    (box :orientation "v" :space-evenly false :spacing 12 :visible {query == ""}
      (label :class "pop-title" :halign "start" :text "pinned")
      (box :spacing 6 :halign "start"
        (for a in pinned
          (app-tile :id {a.q} :name {a.name} :icon {a.icon} :initial {a.initial} :selected {a.idx == sel})))
      (label :class "dim" :halign "start" :text "right-click an app to pin or unpin it"))))

(defwidget launcher-long []
  (box :class "pop dash dash-long" :orientation "v" :space-evenly false :spacing 12
    :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
    (box :space-evenly false :spacing 10
      (input :class "search" :hexpand true :timeout "5s"
             :onchange "~/.config/eww/scripts/apps search '{}'"
             :onaccept "~/.config/eww/scripts/apps run '{}'")
      (button :timeout "10s" :class "pop-btn" :onclick "~/.config/eww/scripts/dash close" "close"))
    (box :orientation "v" :space-evenly false :spacing 4 :visible {query != ""}
      (for r in results
        (result-row :id {r.q} :name {r.name} :icon {r.icon} :initial {r.initial} :pinned {r.pinned} :selected {r.idx == sel}))
      (label :class "dim" :halign "start" :visible {arraylength(results) == 0} :text "no application found"))
    (scroll :vscroll true :hscroll false :vexpand true :visible {query == ""}
      (box :orientation "v" :space-evenly false :spacing 2
        (label :class "pop-title" :halign "start" :text "pinned")
        (for a in pinned
          (result-row :id {a.q} :name {a.name} :icon {a.icon} :initial {a.initial} :pinned false :selected {a.idx == sel}))))))

(defwindow launcher-wide [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "-60px" :width "700px" :anchor "center")
  :stacking "overlay"
  :focusable true
  :namespace "ink-pop"
  (launcher))

(defwindow launcher-long [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "0px" :width "92%" :height "80%" :anchor "center")
  :stacking "overlay"
  :focusable true
  :namespace "ink-pop"
  (launcher-long))

;; ── Dashboard (Alt+Space, or the dock icon): time, system, media, toggles, calendar, notifications ──
(defwidget dashboard []
  (box :class "pop dash" :orientation "v" :space-evenly false :spacing 14
    :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
    (box :space-evenly false
      (label :class "pop-title" :halign "start" :hexpand true :text "dashboard")
      (label :class "dim" :halign "end" :text "up ${uptime}  ")
      (button :timeout "10s" :class "pop-btn" :onclick "~/.config/eww/scripts/dash close" "close"))
    (box :spacing 18 :valign "start"
      (box :orientation "v" :space-evenly false :spacing 10 :valign "start"
        (label :class "dash-time" :halign "start" :text {formattime(EWW_TIME, "%H:%M")})
        (label :class "dim" :halign "start" :text {formattime(EWW_TIME, "%A %d %B")})
        (box :spacing 12 :halign "start"
          (ring :label "cpu" :value {EWW_CPU.avg})
          (ring :label "ram" :value {EWW_RAM.used_mem_perc})
          (ring :label "disk" :value {EWW_DISK["/"].used_perc})))
      (box :orientation "v" :space-evenly false :spacing 10 :valign "start"
        (media-card)
        (box :orientation "v" :space-evenly false :spacing 8
          (box :spacing 8
            (tile :label "Wi-Fi" :sub {qs.wifi ? (qs.ssid != "" ? qs.ssid : "on") : "off"} :on {qs.wifi} :action "wifi")
            (tile :label "Bluetooth" :sub {qs.bt ? "on" : "off"} :on {qs.bt} :action "bluetooth"))
          (box :spacing 8
            (tile :label "Do not disturb" :sub {qs.dnd ? "on" : "off"} :on {qs.dnd} :action "dnd")
            (tile :label "Night light" :sub {qs.night ? "on" : "off"} :on {qs.night} :action "night"))))
      (calendar :class "cal" :valign "start" :show-heading true :show-week-numbers false))
    (label :class "pop-title" :halign "start" :text "recent notifications")
    (box :orientation "v" :space-evenly false :spacing 6
      (for n in {nt.items}
        (notif-item :app {n.app} :summary {n.summary} :body {n.body}))
      (label :class "dim" :halign "start" :visible {arraylength(nt.items) == 0} :text "nothing yet"))))

(defwidget dashboard-long []
  (box :class "pop dash dash-long" :orientation "v" :space-evenly false :spacing 12
    :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
    (box :space-evenly false
      (label :class "pop-title" :halign "start" :hexpand true :text "dashboard")
      (button :timeout "10s" :class "pop-btn" :onclick "~/.config/eww/scripts/dash close" "close"))
    (scroll :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false :spacing 16
        (box :orientation "v" :space-evenly false :spacing 2
          (label :class "dash-time" :halign "start" :text {formattime(EWW_TIME, "%H:%M")})
          (label :class "dim" :halign "start" :text {formattime(EWW_TIME, "%A %d %B")}))
        (box :spacing 12 :halign "center"
          (ring :label "cpu" :value {EWW_CPU.avg})
          (ring :label "ram" :value {EWW_RAM.used_mem_perc})
          (ring :label "disk" :value {EWW_DISK["/"].used_perc}))
        (media-card)
        (box :orientation "v" :space-evenly false :spacing 8
          (box :spacing 8
            (tile :label "Wi-Fi" :sub {qs.wifi ? (qs.ssid != "" ? qs.ssid : "on") : "off"} :on {qs.wifi} :action "wifi")
            (tile :label "Bluetooth" :sub {qs.bt ? "on" : "off"} :on {qs.bt} :action "bluetooth"))
          (box :spacing 8
            (tile :label "Do not disturb" :sub {qs.dnd ? "on" : "off"} :on {qs.dnd} :action "dnd")
            (tile :label "Night light" :sub {qs.night ? "on" : "off"} :on {qs.night} :action "night")))
        (label :class "pop-title" :halign "start" :text "recent notifications")
        (box :orientation "v" :space-evenly false :spacing 6
          (for n in {nt.items}
            (notif-item :app {n.app} :summary {n.summary} :body {n.body}))
          (label :class "dim" :halign "start" :visible {arraylength(nt.items) == 0} :text "nothing yet"))
        (calendar :class "cal" :show-heading true :show-week-numbers false)))))

(defwindow dashboard-wide [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "0px" :width "800px" :anchor "center")
  :stacking "overlay"
  :namespace "ink-pop"
  (dashboard))

(defwindow dashboard-long [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "0px" :width "92%" :height "88%" :anchor "center")
  :stacking "overlay"
  :namespace "ink-pop"
  (dashboard-long))

;; ── Expose (Super+Tab): every workspace and window as a thumbnail, click one to jump to it ──
(defwidget expose-card [id title initial thumb focused scratch]
  (button :timeout "10s" :class "ecard ${focused ? 'focused' : ''}" :tooltip title
          :onclick {scratch ? "~/.config/eww/scripts/expose goto-scratch ${id}" : "~/.config/eww/scripts/expose goto ${id}"}
    (box :orientation "v" :space-evenly false :spacing 6
      (box :class "ethumb" :width 300 :height 170
        (image :visible {thumb != ""} :path {thumb} :image-width 300 :image-height 170)
        (label :visible {thumb == ""} :class "app-initial" :text initial))
      (label :class "dim" :limit-width 28 :text title))))

(defwidget expose-ws [name focused scratch windows]
  (box :orientation "v" :space-evenly false :spacing 6
    (button :timeout "10s" :class "ews ${focused ? 'focused' : ''}" :halign "start"
            :onclick "~/.config/eww/scripts/expose workspace ${name}"
      {scratch ? "minimised" : "workspace ${name}"})
    (box :spacing 12 :halign "start"
      (for w in windows
        (expose-card :id {w.id} :title {w.title} :initial {w.initial} :thumb {w.thumb} :focused {w.focused} :scratch scratch))
      (label :class "dim" :visible {arraylength(windows) == 0} :text "empty"))))

(defwidget expose-view []
  (box :class "pop dash" :orientation "v" :space-evenly false :spacing 14
    :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
    (box :space-evenly false
      (label :class "pop-title" :halign "start" :hexpand true :text "expose")
      (label :class "dim" :halign "end" :text "click a window to jump to it   ")
      (button :timeout "10s" :class "pop-btn" :onclick "~/.config/eww/scripts/dash close" "close"))
    (scroll :vscroll true :hscroll true :vexpand true
      (box :orientation "v" :space-evenly false :spacing 18
        (for scr in expose
          (box :orientation "v" :space-evenly false :spacing 10
            ;; one section per screen; the minimised windows are in a last section of their own
            (box :class "escreen" :space-evenly false :spacing 10 :halign "start"
              (label :class "pop-title" :text {scr.output != "" ? "screen ${scr.output}" : "no screen"})
              (label :class "dim" :text {scr.output != "" ? scr.size : "hidden"}))
            (for ws in {scr.workspaces}
              (expose-ws :name {ws.name} :focused {ws.focused} :scratch {ws.scratch} :windows {ws.windows}))))))))

(defwindow expose [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "0px" :width "94%" :height "88%" :anchor "center")
  :stacking "overlay"
  :namespace "ink-pop"
  (expose-view))
