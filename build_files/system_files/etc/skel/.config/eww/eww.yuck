;; Ink bar — workspaces | clock | layout, stats, tray
(deflisten workspaces :initial "[]" "~/.config/eww/scripts/workspaces")
(deflisten scratch :initial "[]" "ink-scratch watch")
(deflisten media :initial "{\"status\":\"Stopped\",\"artist\":\"\",\"title\":\"\"}" "~/.config/eww/scripts/media")
(deflisten layout :initial "qwerty" "ink-layout watch")
(defpoll sink :interval "1s" :initial "{\"vol\":0,\"muted\":false}" "~/.config/eww/scripts/audio sink")
(defpoll adev :interval "2s" :run-while {vol_pill || vol_pop} :initial "{\"sinks\":[],\"sources\":[]}" "~/.config/eww/scripts/audio devices")
(defpoll src :interval "1s" :initial "{\"vol\":0,\"muted\":false}" "~/.config/eww/scripts/audio source")
(defpoll nt :interval "2s" :initial "{\"dnd\":false,\"count\":0,\"items\":[]}" "~/.config/eww/scripts/notifs")
(defvar dock_apps "[]")
(defpoll uptime :interval "60s" "uptime -p | sed 's/^up //'")
;; hover state for the flyouts (a flyout closes only when neither its pill nor itself is hovered)
;; what the layout picker acts on: "ws" (the workspace of a screen, from the dock item) or "win" (the focused window's own group, Super+G)
(defvar lay_scope "ws")
;; the screen the open picker acts on
(defvar lay_target "")
;; layout of the visible workspace of each screen, by output name: {"DP-3":"t",...} (h, v, t or s; kept by scripts/wslayout watch)
(defvar wslay "{}")
(defvar vol_pill false)
(defvar vol_pop false)
(defvar nt_pill false)
(defvar nt_pop false)
(defvar cal_pill false)
(defvar cal_pop false)
(defvar expose "[]")
;; window picked up in the expose view (right-click it), to be put on a workspace (click the workspace)
(defvar picked "")
(defvar vol_sink_v 0)
(defvar vol_source_v 0)
(defvar query "")
(defvar sel 0)
(defvar results "[]")
(defvar pinned "[]")
(defvar lmsg "")
(defvar keys_pill false)
(defvar keys_pop false)
(defvar qs_pill false)
(defvar qs_pop false)
(defvar pwr_confirm "")
(defpoll qs :interval "3s" :initial "{\"wifi\":false,\"ssid\":\"\",\"bt\":false,\"dnd\":false,\"night\":false,\"caffeine\":false,\"profile\":\"unknown\",\"bright\":-1}" "~/.config/eww/scripts/qs")
(defpoll clock :interval "10s" "date '+%a %d %b  %H:%M'")

(defwidget bar-content [mon out]
  (centerbox :class "bar" :orientation "h"
    (box :halign "start" :space-evenly false
      (for ws in workspaces
        (button :timeout "10s" :visible {ws.output == out} :class "ws ${ws.focused ? 'focused' : ws.visible ? 'visible' : ''} ${ws.urgent ? 'urgent' : ''}"
                :onclick "swaymsg workspace ${ws.name}"
          {ws.focused ? "◉ ${ws.name}" : "○ ${ws.name}"})))
    (box :halign "center"
      (eventbox :timeout "10s" :onhover "eww update cal_pill=true && eww open cal --arg mon=${mon}"
                :onhoverlost "eww update cal_pill=false && ~/.config/eww/scripts/popclose cal cal"
        (label :class "pill clock" :text clock)))
    (box :halign "end" :space-evenly false
      (eventbox :timeout "10s" :onhover "eww update keys_pill=true && eww open keys --arg mon=${mon}"
                :onhoverlost "eww update keys_pill=false && ~/.config/eww/scripts/popclose keys keys"
        (button :timeout "10s" :class "pill layout" :onclick "ink-layout next" :onrightclick "ink-layout prev"
          {"⌨ ${layout == 'bepo' ? 'BÉPO' : layout == 'azerty' ? 'AZERTY' : 'QWERTY'}"}))
      (eventbox :timeout "10s" :onhover "eww update vol_pill=true && eww open volpop --arg mon=${mon}; ~/.config/eww/scripts/audio sync"
                :onhoverlost "eww update vol_pill=false && ~/.config/eww/scripts/popclose volpop vol"
                :onscroll "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%{}"
                :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        (box :class "pill vol ${sink.muted ? 'muted' : ''}" :tooltip {sink.muted ? "muted" : "volume ${sink.vol}%"}
          (image :path {"${EWW_CONFIG_DIR}/icons/" + (sink.muted ? "vol-muted" : sink.vol < 34 ? "vol-low" : "vol-high") + ".svg"}
                 :image-width 18 :image-height 18)))
      (eventbox :timeout "10s" :onhover "eww update nt_pill=true && eww open notifs --arg mon=${mon}"
                :onhoverlost "eww update nt_pill=false && ~/.config/eww/scripts/popclose notifs nt"
                :onclick "makoctl mode -t do-not-disturb; ~/.config/eww/scripts/notifs push"
        (box :class "pill" :tooltip {nt.dnd ? "do not disturb" : nt.count > 0 ? "${nt.count} notification(s)" : "no notifications"}
          (image :path {"${EWW_CONFIG_DIR}/icons/" + (nt.dnd ? "bell-off" : nt.count > 0 ? "bell-dot" : "bell") + ".svg"}
                 :image-width 18 :image-height 18)))
      ;; Caffeine: click to keep the screen awake (no auto-lock, no blanking), click again to go back
      (eventbox :timeout "10s" :onclick "~/.config/eww/scripts/toggle caffeine; ~/.config/eww/scripts/qs push"
        (box :class "pill caf ${qs.caffeine ? 'on' : ''}" :tooltip {qs.caffeine ? "caffeine: the screen stays awake (click to stop)" : "caffeine: keep the screen awake"}
          (image :path {"${EWW_CONFIG_DIR}/icons/" + (qs.caffeine ? "coffee-on" : "coffee") + ".svg"}
                 :image-width 18 :image-height 18)))
      (label :class "pill bat ${EWW_BATTERY == '' ? '' : 'show'}"
             :visible {EWW_BATTERY != ""}
             :text "bat ${EWW_BATTERY == '' ? '' : EWW_BATTERY.total_avg}%")
      (systray :class "pill" :icon-size 16 :spacing 6)
      (eventbox :timeout "10s" :onhover "eww update qs_pill=true && eww open quick --arg mon=${mon}"
                :onhoverlost "eww update qs_pill=false && ~/.config/eww/scripts/popclose quick qs"
        (box :class "pill qs" (image :path "${EWW_CONFIG_DIR}/icons/paw.svg" :image-width 18 :image-height 18))))))

;; A brown thorny branch with flowers and a rose runs along the bottom edge of the bar.
;; It sits below the bar, so it never covers any widget.
(defwidget bar [mon out]
  (box :orientation "v" :space-evenly false
    (box :class "bar-pad" (bar-content :mon mon :out out))
    (box :class "vine" :height 16
         :style "background-image: url('${EWW_CONFIG_DIR}/icons/vine-bottom.svg');")))

(defwindow bar [mon out]
  :monitor mon
  :geometry (geometry :x "0%" :y "6px" :width "98%" :height "54px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "ink-bar"
  (bar :mon mon :out out))

;; Bottom strip — landscape screens only. Minimised windows (sway scratchpad) on the left; on the right the dock (small) and the media player.
;; It reserves its own height at the bottom edge, so windows stop above it instead of running to the bottom of the screen.
(defwidget strip [mon out]
  (box :orientation "v" :space-evenly false
    (box :class "strip" :orientation "h" :space-evenly false :height 36
      (box :orientation "h" :space-evenly false :halign "start" :hexpand true :spacing 6
        (label :class "dim" :visible {arraylength(scratch) == 0} :text "Alt+Esc minimises a window here")
        (for w in scratch
          (button :timeout "10s" :class "strip-win" :tooltip {w.name} :onclick "ink-scratch show ${w.id}"
            (label :limit-width 24 :text "${w.initial}  ${w.name}"))))
      (box :orientation "h" :space-evenly false :halign "end" :spacing 8
        ;; the dock of a landscape screen: the same apps as on a portrait screen, small, next to the player
        (box :class "strip-dock" :orientation "h" :space-evenly false
          (dock-app :app "launcher" :tip "App launcher" :size 20)
          (dock-app :app "dashboard" :tip "Dashboard" :size 20)
          (dock-lay :win "layoutpop-center" :size 20 :mon mon :out out)
          (for a in dock_apps
            (dock-item :id {a.q} :name {a.name} :icon {a.icon} :initial {a.initial} :builtin {a.builtin} :size 20)))
        (box :class "strip-player" :orientation "h" :space-evenly false :spacing 8
          (label :class "strip-track" :limit-width 48
                 :text {media.title != "" ? (media.artist != "" ? "${media.artist} — ${media.title}" : media.title) : "nothing playing"})
          (button :timeout "10s" :class "strip-btn" :onclick "playerctl previous" "‹")
          (button :timeout "10s" :class "strip-btn" :onclick "playerctl play-pause" {media.status == "Playing" ? "❚❚" : "▶"})
          (button :timeout "10s" :class "strip-btn" :onclick "playerctl next" "›"))))))

(defwindow strip [mon out]
  :monitor mon
  ;; 36 px tall
  :geometry (geometry :x "0%" :y "6px" :width "98%" :height "36px" :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  :namespace "ink-bar"
  (strip :mon mon :out out))

;; Workspaces of a portrait screen (it has no bar), to the left of the dock and as tall as the dock. Only this screen's workspaces.
(defwidget wsdock [out]
  (box :class "wsdock" :orientation "h" :space-evenly false :halign "start" :valign "fill"
    (for ws in workspaces
      (button :timeout "10s" :visible {ws.output == out}
              :class "ws ${ws.focused ? 'focused' : ws.visible ? 'visible' : ''} ${ws.urgent ? 'urgent' : ''}"
              :onclick "swaymsg workspace ${ws.name}"
        {ws.name}))))

(defwindow ws-dock [mon out]
  :monitor mon
  ;; same height and bottom edge as the dock and the clock (y is negative for the same reason as the clock's)
  :geometry (geometry :x "24px" :y "-76px" :height "76px" :anchor "bottom left")
  :stacking "fg"
  :exclusive false
  :namespace "ink-dock"
  (wsdock :out out))

;; Dock — pinned apps. Shown only on portrait screens, centred at the bottom (landscape screens get the bar instead). Icons are Ink-styled SVGs in ~/.config/eww/icons.
(defwidget dock-app [app tip size]
  (button :timeout "10s" :class "dock-icon" :tooltip tip :onclick "~/.config/eww/scripts/launch ${app} &"
    (image :path "${EWW_CONFIG_DIR}/icons/${app}.svg" :image-width size :image-height size)))

;; An application of the dock: click starts it, right-click removes it from the dock. Add one with a middle-click on it in
;; the launcher. The list is ~/.config/ink/dock.
(defwidget dock-item [id name icon initial builtin size]
  (button :timeout "10s" :class "dock-icon" :tooltip "${name}  (right-click: remove from the dock)"
          :onclick {builtin ? "~/.config/eww/scripts/launch ${id}" : "~/.config/eww/scripts/apps launch ${id}"}
          :onrightclick "~/.config/eww/scripts/apps dock-toggle ${id}"
    (box
      (image :visible {icon != ""} :path {icon} :image-width size :image-height size)
      (label :visible {icon == ""} :class "app-initial" :text initial))))

;; The layout of the workspace: the third fixed item of a dock, after the launcher and the dashboard. It shows the layout of its
;; screen; a click opens (or closes) the picker, like the launcher and the dashboard (win = the picker window that fits that dock).
(defwidget dock-lay [win size mon out]
  (button :timeout "10s" :class "dock-icon dock-lay" :tooltip "layout of the workspace (click)"
          :onclick "~/.config/eww/scripts/wslayout panel ${out} ${win} ${mon} &"
    (image :path "${EWW_CONFIG_DIR}/icons/lay-${wslay[out] ?: 'h'}.svg" :image-width size :image-height size)))

(defwidget dock [mon out]
  (box :class "dock" :orientation "h" :space-evenly false
    ;; minimised windows (sway scratchpad): click to bring one back
    (box :orientation "h" :space-evenly false :visible {arraylength(scratch) > 0}
      (for w in scratch
        (button :timeout "10s" :class "dock-icon mini" :tooltip {w.name} :onclick "ink-scratch show ${w.id}"
          (label :text {w.initial})))
      (box :class "dock-sep" :width 2))
    (dock-app :app "launcher" :tip "App launcher" :size 44)
    (dock-app :app "dashboard" :tip "Dashboard" :size 44)
    (dock-lay :win "layoutpop-center" :size 44 :mon mon :out out)
    (for a in dock_apps
      (dock-item :id {a.q} :name {a.name} :icon {a.icon} :initial {a.initial} :builtin {a.builtin} :size 44))))

(defwidget bigclock []
  (box :class "bigclock" :valign "fill" :halign "fill"
    (label :class "bigclock-time" :hexpand true :vexpand true :text {formattime(EWW_TIME, "%H:%M")})))

;; The big clock sits at the bottom right of a portrait screen, to the right of the dock, and is as tall as the dock.
;; It shows only the time: a portrait screen has no bar, so this is where its time is.
(defwindow clock-big [mon]
  :monitor mon
  ;; a fixed size: sized from its content, the window would be laid out before the time has a value and keep that width.
  ;; y is negative because the dock reserves its own height at the bottom edge and this window is placed above that zone:
  ;; -76 px brings its bottom edge level with the dock (16 px from the screen edge).
  :geometry (geometry :x "24px" :y "-76px" :width "180px" :height "76px" :anchor "bottom right")
  :stacking "fg"
  :exclusive false
  :namespace "ink-dock"
  (bigclock))

(defwindow dock [mon out]
  :monitor mon
  :geometry (geometry :x "0px" :y "16px" :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  :namespace "ink-dock"
  (dock :mon mon :out out))

;; ── Flyouts ──────────────────────────────────────────────
;; Open on hover over their pill in the bar, close shortly after the pointer leaves both.
(defwidget meter [label value]
  (box :class "meter" :orientation "v" :space-evenly false
    (box :space-evenly false
      (label :class "dim" :halign "start" :hexpand true :text label)
      (label :halign "end" :text "${round(value, 0)}%"))
    (progress :value value :class "bar-meter")))

(defwidget lay-card [id name key desc out]
  (button :timeout "10s" :class "lcard ${lay_scope == 'ws' && wslay[out] == id ? 'current' : ''}"
          :onclick "~/.config/eww/scripts/wslayout apply ${out} ${id}; ~/.config/eww/scripts/wslayout close"
    (box :orientation "v" :space-evenly false :spacing 4
      (image :path "${EWW_CONFIG_DIR}/icons/lay-${id}.svg" :image-width 40 :image-height 40)
      (label :class "lname" :text "${name}  ${key}")
      (label :class "dim" :text desc)
      (label :class "lcur" :visible {lay_scope == "ws" && wslay[out] == id} :text "current"))))

(defwidget layoutpop [win out]
  (box :class "pop" :orientation "v" :space-evenly false :spacing 10
    :style "background-image: url('${EWW_CONFIG_DIR}/icons/fur.svg');"
    (label :class "pop-title" :halign "start" :text {lay_scope == "win" ? "layout of the focused window" : "layout of the workspace on ${out}"})
    (box :spacing 8
      (lay-card :id "h" :name "Horizontal" :key "H" :desc "side by side" :out out)
      (lay-card :id "v" :name "Vertical" :key "V" :desc "top to bottom" :out out)
      (lay-card :id "t" :name "Tabbed" :key "T" :desc "tabs in a row" :out out)
      (lay-card :id "s" :name "Stacked" :key "S" :desc "title list" :out out))
    (label :class "dim" :halign "start" :text {lay_scope == "win" ? "its own group, new windows open inside  ·  Super+G, then H V T S" : "H V T S to choose  ·  Esc to close"})))

;; the picker opened by a click on the layout item of a dock: at the centre of the screen, like the launcher and the dashboard
(defwindow layoutpop-center [mon out]
  :monitor mon
  :geometry (geometry :x "0px" :y "-60px" :width "600px" :anchor "center")
  :stacking "overlay"
  :namespace "ink-pop"
  (layoutpop :win "layoutpop-center" :out out))

;; Where is the pointer? A transparent full-screen window that is there for a moment: the toolkit reports the position of the
;; pointer when the window appears under it (scripts/wslayout pointer). The picker of Super+G opens under that point.
(defwindow ptrprobe [mon]
  :monitor mon
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :exclusive false
  :namespace "ink-ptr"
  (eventbox :timeout "5s" :onhover "echo '{0} {1}' > $XDG_RUNTIME_DIR/ink-ptr"
    (box :class "ptrprobe" :hexpand true :vexpand true)))

;; the picker opened by the keyboard: its position is given when it opens (--pos), under the pointer
(defwindow layoutpop-ptr [mon out]
  :monitor mon
  :geometry (geometry :x "0px" :y "0px" :width "600px" :anchor "top left")
  :stacking "overlay"
  :namespace "ink-pop"
  (layoutpop :win "layoutpop-ptr" :out out))
