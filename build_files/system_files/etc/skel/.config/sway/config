# Ink — swayfx config (Pixel Guild look: the Inkunome design system's pixel register, dark theme)
set $mod Mod4
set $term alacritty
set $menu fuzzel

# ── palette ────────────────────────────────────────────────
# the design system's tokens; the source is ~/.config/eww/_tokens.scss (same values, same names)
set $bg        #150F28
set $surface   #20173A
set $fg        #F3ECFF
set $muted     #A99BC9
set $line      #4A3B7A
set $accent    #FF7AA8
set $on_accent #150F28
set $bad       #FF8A80

# ── look (swayfx) ──────────────────────────────────────────
font pango:IBM Plex Mono 10
default_border pixel 3
# new windows open as tabs of the workspace by default (Super+E splits, Super+W re-tabs);
# when a container is split, tile side by side on landscape screens and stacked on portrait ones
workspace_layout tabbed
default_orientation auto
title_align center
titlebar_padding 10 5
# hard frames: 3 px around the content and around the title (sway cannot set a thickness per focus state)
titlebar_border_thickness 3
gaps inner 8
gaps outer 4
# square corners, nothing translucent
corner_radius 0
blur disable
# a hard shadow under the focused window only: 4 px right and down, in the line colour. The radius is the shader's sigma
# and it divides by it, so 0 is undefined: 1 is the smallest defined value, the least softening swayfx can draw
shadows enable
shadow_blur_radius 1
shadow_offset 4 4
shadow_color #4A3B7AFF
shadow_inactive_color #4A3B7A00
default_dim_inactive 0
# the bar, the dock, the panels and the notifications get no compositor effect: eww and mako draw their own frames

# every window has a frame around its content and around its title (3 px each): the focused one is filled with the accent,
# the others have a frame in the line colour
#                       border    bg       text        indicator child_border
client.focused          $accent   $accent  $on_accent  $accent   $accent
client.focused_inactive $line     $bg      $fg         $line     $line
client.unfocused        $line     $bg      $muted      $line     $line
client.urgent           $bad      $bad     $on_accent  $bad      $bad

output * bg $bg solid_color
# wallpaper: change the file to switch. ink-pixel-dusk is the default of this look; the previous default, lilac-dusk.jpg,
# and forest-night, ink-feathers and loam-moss are also installed in /usr/share/backgrounds/ink/
output * bg /usr/share/backgrounds/ink/ink-pixel-dusk.png fill

# ── input: bépo / azerty / qwerty ──────────────────────────
# Order = ink-layout indices: 0 qwerty (the default), 1 azerty, 2 bepo
input type:keyboard {
    xkb_layout  "us,fr,fr"
    xkb_variant ",,bepo"
    xkb_numlock enabled
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
}
bindsym $mod+space exec ink-layout next
bindsym $mod+Shift+space exec ink-layout prev
bindsym $mod+Ctrl+1 exec ink-layout set bepo
bindsym $mod+Ctrl+2 exec ink-layout set azerty
bindsym $mod+Ctrl+3 exec ink-layout set qwerty

# spellbook: persistent zellij session "code" in a dedicated alacritty window
bindsym $mod+Ctrl+space exec alacritty --title spellbook --command zellij attach code --create options --default-layout compact --show-startup-tips false

# ── bindings ───────────────────────────────────────────────
# Letters/digits use bindcode (physical key positions, QWERTY names in comments)
# so shortcuts stay in the same place whatever layout is active.
floating_modifier $mod normal
bindsym $mod+Return fullscreen
bindsym $mod+Shift+Return exec $term
bindcode $mod+28 exec alacritty --command zellij -l welcome options --default-layout compact --show-startup-tips false   # T
bindcode $mod+40 exec ~/.config/eww/scripts/dash toggle launcher   # D: app launcher
bindsym Ctrl+space exec ~/.config/eww/scripts/dash toggle launcher
bindsym Mod1+space exec ~/.config/eww/scripts/dash toggle dashboard
bindcode $mod+Shift+24 kill                       # Q
bindcode Ctrl+Mod1+41 kill                        # Ctrl+Alt+F
# sway cannot draw a clickable cross in a tab, so a middle click on a tab title (the default target of a mouse binding) closes it
bindsym button2 kill
bindcode $mod+Shift+54 reload                     # C
bindcode $mod+Shift+26 exec wlogout -b 4          # E
bindcode $mod+46 exec ink-lock                        # L
bindcode $mod+41 fullscreen                       # F
bindcode $mod+Shift+41 floating toggle            # F
bindcode $mod+26 layout toggle split              # E
bindcode $mod+25 layout tabbed                    # W
bindcode $mod+42 exec ~/.config/eww/scripts/wslayout pop     # G: layout of the focused window (its own group), picker under the mouse

# minimise to the dock (scratchpad): Alt+Esc sends the focused window away, Alt+Tab cycles through them
bindsym Mod1+Escape exec ink-scratch minimize
bindsym Mod1+Tab exec ink-scratch cycle

# focus a window: Super+arrows. Move it: Super+Shift+arrows. In a tabbed container, moving a window
# sideways takes it out of the tabs and splits the screen (the way to tile windows side by side).
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# workspaces on the number row (keycodes 10..18 = 1..9)
bindcode $mod+10 workspace 1
bindcode $mod+11 workspace 2
bindcode $mod+12 workspace 3
bindcode $mod+13 workspace 4
bindcode $mod+14 workspace 5
bindcode $mod+15 workspace 6
bindcode $mod+16 workspace 7
bindcode $mod+17 workspace 8
bindcode $mod+18 workspace 9
bindcode $mod+Shift+10 move container to workspace 1
bindcode $mod+Shift+11 move container to workspace 2
bindcode $mod+Shift+12 move container to workspace 3
bindcode $mod+Shift+13 move container to workspace 4
bindcode $mod+Shift+14 move container to workspace 5
bindcode $mod+Shift+15 move container to workspace 6
bindcode $mod+Shift+16 move container to workspace 7
bindcode $mod+Shift+17 move container to workspace 8
bindcode $mod+Shift+18 move container to workspace 9

# screenshots, clipboard history, media
# workspaces: next/previous, send a window along, move a workspace to another screen.
# Super+Tab opens the expose view; pressing the number of the current workspace goes back to the previous one.
workspace_auto_back_and_forth yes
bindsym $mod+Prior workspace prev_on_output
bindsym $mod+Next workspace next_on_output
bindsym $mod+Ctrl+Left workspace prev_on_output
bindsym $mod+Ctrl+Right workspace next_on_output
bindsym $mod+Tab exec ~/.config/eww/scripts/dash toggle expose
bindsym $mod+Shift+Prior move container to workspace prev_on_output; workspace prev_on_output
bindsym $mod+Shift+Next move container to workspace next_on_output; workspace next_on_output
bindsym $mod+Ctrl+Shift+Left move container to workspace prev_on_output; workspace prev_on_output
bindsym $mod+Ctrl+Shift+Right move container to workspace next_on_output; workspace next_on_output
bindsym $mod+Mod1+Left move workspace to output left
bindsym $mod+Mod1+Right move workspace to output right
bindsym --whole-window $mod+button4 workspace prev_on_output
bindsym --whole-window $mod+button5 workspace next_on_output
bindcode $mod+19 workspace 10
bindcode $mod+Shift+19 move container to workspace 10

# windows: focus the parent / child container
bindcode $mod+38 focus parent                    # A
bindcode $mod+Shift+38 focus child               # A

# screenshots on Super+S (key position, so it works in bépo, azerty and qwerty):
#   Super+S = area -> editor, Super+Shift+S = menu (mode, action, 5 s delay),
#   Super+Ctrl+S = full screen -> file, Super+Alt+S = window -> clipboard
bindcode $mod+39 exec ink-screenshot area edit              # S
bindcode $mod+Shift+39 exec ink-screenshot menu             # S
bindcode $mod+Ctrl+39 exec ink-screenshot screen save       # S
bindcode $mod+Mod1+39 exec ink-screenshot window copy       # S
bindcode $mod+54 exec cliphist list | fuzzel --dmenu | cliphist decode | wl-copy   # C
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# ── autostart ──────────────────────────────────────────────
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
# tell systemd the graphical session is up (the desktop portals, which open links from Flatpak apps, need it)
exec systemctl --user start sway-session.target
exec swaymsg -mt subscribe '["shutdown"]' && systemctl --user stop sway-session.target
exec mako
exec udiskie --tray
exec /usr/libexec/polkit-mate-authentication-agent-1
# unlock the SSH key once for the session (a small passphrase dialog, only when there is a key and none is loaded yet)
exec ink-ssh-load
exec nm-applet --indicator
exec blueman-applet
exec wl-paste --watch cliphist store
exec wl-clip-persist --clipboard regular
# never lock or blank the screen while a window is fullscreen (a video, a game): the window keeps the session awake as long as
# it is fullscreen. Wayland windows have an app_id, XWayland ones (games under Wine, Steam) a class.
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen
# idle: lock after 5 minutes, blank the screens after 10; the caffeine button of the bar turns it off
exec ~/.config/eww/scripts/caffeine run
# bar on landscape screens, dock on portrait screens: re-evaluated at every reload and whenever outputs change
# screen layout profiles (position, rotation): kanshi runs only if ~/.config/kanshi/config exists, and is told to
# re-apply its profile after every reload (a reload puts the screens back in automatic layout)
exec sh -c 'test -f ~/.config/kanshi/config && exec kanshi'
exec_always sh -c 'test -f ~/.config/kanshi/config && pgrep -x kanshi >/dev/null && kanshictl reload'
exec_always ~/.config/eww/scripts/screens apply
exec ~/.config/eww/scripts/screens watch
exec ~/.config/eww/scripts/expose watch
exec ~/.config/eww/scripts/winpill watch
# two eww daemons at once would leave a launcher that cannot be closed: restart eww cleanly when that happens
exec ~/.config/eww/scripts/ewwguard
# in a fullscreen window (a game) the shortcuts without Super are off, see ink-gameguard
exec ink-gameguard watch

# while the launcher or dashboard is open, Escape / Ctrl+Space / Alt+Space close it (Escape leaves the mode by itself, and
# Ctrl+Alt+Escape kills and restarts eww if the panel hangs and eats the keyboard)
# the launcher: Up/Down/Tab/Shift+Tab move the selection (Left/Right too while the search is empty, see below), Return launches it (typing still goes to the search field)
mode "launcher" {
    bindsym Escape mode "default"; exec ~/.config/eww/scripts/dash close
    bindsym Ctrl+Mod1+Escape exec ~/.config/eww/scripts/panic
    bindsym Ctrl+space exec ~/.config/eww/scripts/dash close
    bindsym Mod1+space exec ~/.config/eww/scripts/dash close
    bindsym $mod+Tab exec ~/.config/eww/scripts/dash close
    bindsym Down exec ~/.config/eww/scripts/apps nav next
    bindsym Tab exec ~/.config/eww/scripts/apps nav next
    bindsym Up exec ~/.config/eww/scripts/apps nav prev
    bindsym Shift+Tab exec ~/.config/eww/scripts/apps nav prev
    bindsym Return exec ~/.config/eww/scripts/apps accept
    bindsym KP_Enter exec ~/.config/eww/scripts/apps accept
}

# the same while the search field is empty: Left and Right choose a pinned app (`apps search` switches between the two)
mode "launcher-pinned" {
    bindsym Escape mode "default"; exec ~/.config/eww/scripts/dash close
    bindsym Ctrl+Mod1+Escape exec ~/.config/eww/scripts/panic
    bindsym Ctrl+space exec ~/.config/eww/scripts/dash close
    bindsym Mod1+space exec ~/.config/eww/scripts/dash close
    bindsym $mod+Tab exec ~/.config/eww/scripts/dash close
    bindsym Down exec ~/.config/eww/scripts/apps nav next
    bindsym Tab exec ~/.config/eww/scripts/apps nav next
    bindsym Right exec ~/.config/eww/scripts/apps nav right
    bindsym Up exec ~/.config/eww/scripts/apps nav prev
    bindsym Shift+Tab exec ~/.config/eww/scripts/apps nav prev
    bindsym Left exec ~/.config/eww/scripts/apps nav left
    bindsym Return exec ~/.config/eww/scripts/apps accept
    bindsym KP_Enter exec ~/.config/eww/scripts/apps accept
}

# Super+G opens the layout picker under the mouse for the focused window itself: H V T S give it its own group with that layout
mode "winlayout" {
    bindsym h exec ~/.config/eww/scripts/wslayout win h; exec ~/.config/eww/scripts/wslayout close
    bindsym v exec ~/.config/eww/scripts/wslayout win v; exec ~/.config/eww/scripts/wslayout close
    bindsym t exec ~/.config/eww/scripts/wslayout win t; exec ~/.config/eww/scripts/wslayout close
    bindsym s exec ~/.config/eww/scripts/wslayout win s; exec ~/.config/eww/scripts/wslayout close
    bindsym Escape exec ~/.config/eww/scripts/wslayout close
    bindsym Return exec ~/.config/eww/scripts/wslayout close
}

mode "dash" {
    bindsym Escape mode "default"; exec ~/.config/eww/scripts/dash close
    bindsym Ctrl+Mod1+Escape exec ~/.config/eww/scripts/panic
    bindsym Ctrl+space exec ~/.config/eww/scripts/dash close
    bindsym Mod1+space exec ~/.config/eww/scripts/dash close
    bindsym $mod+Tab exec ~/.config/eww/scripts/dash close
}

include /etc/sway/config.d/*

# your own settings go in ~/.config/ink/sway.d/*.conf (wallpapers, per-device input, extra keys). They are read last, so
# they override this file, and they are not touched by ink-sync.
include ~/.config/ink/sway.d/*.conf
